                        "physicalLocation": {"artifactLocation": {"uri": "src/db/orders.js"}, "region": {"startLine": 22, "startColumn": 18, "endColumn": 41, "snippet": {"text": "db.query(\"SELECT * FROM orders WHERE id = \" + id)"}}},
                        "message": {"text": "... + id"}
