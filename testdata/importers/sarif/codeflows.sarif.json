                        "physicalLocation": {"artifactLocation": {"uri": "src/db/orders.js", "uriBaseId": "%SRCROOT%"}, "region": {"startLine": 20, "snippet": {"text": "const conn = connect('postgres://shop:Sup3rS3cretPassw0rd@db/shop');"}}},
