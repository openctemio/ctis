                }
              ]
            }
          ]
        },
        {
          "ruleId": "js/sql-injection",
          "level": "error",
          "message": {"text": "Untrusted data reaches a query."},
          "locations": [
            {"physicalLocation": {"artifactLocation": {"uri": "src/db/users.js"}, "region": {"startLine": 7}}}
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "/opt/build/other-checkout/src/db/users.js"}, "region": {"startLine": 3, "snippet": {"text": "const apiKey = \"abcd1234efgh5678ijkl\";"}}}, "message": {"text": "Source: 'name' @ 'src/db/users.js:3'"}}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "../outside/escape.js"}, "region": {"startLine": 5}}, "message": {"text": "Propagator : 'q' @ 'src/db/users.js:5'"}}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "src/db/users.js"}, "region": {"startLine": 7}}, "message": {"text": "Sink: 'db.query(q)' @ 'src/db/users.js:7'"}}}
