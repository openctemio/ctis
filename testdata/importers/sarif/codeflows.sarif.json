                        "message": {"text": "id"}
                      }
                    },
                    {
                      "kinds": ["sanitizer"],
                      "location": {
                        "physicalLocation": {"artifactLocation": {"uri": "src/db/orders.js"}, "region": {"startLine": 21, "snippet": {"text": "const safe = escapeLike(id);"}}},
                        "message": {"text": "escapeLike(id)"}
