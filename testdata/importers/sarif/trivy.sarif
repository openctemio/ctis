{
  "version": "2.1.0",
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "fullName": "Trivy Vulnerability Scanner",
          "informationUri": "https://github.com/aquasecurity/trivy",
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2021-44228",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {"text": "log4j-core: Remote code execution in Log4j 2.x when logs contain an attacker-controlled string value"},
              "fullDescription": {"text": "Apache Log4j2 2.0-beta9 through 2.15.0 JNDI features do not protect against attacker controlled LDAP endpoints."},
              "defaultConfiguration": {"level": "error"},
              "helpUri": "https://avd.aquasec.com/nvd/cve-2021-44228",
              "help": {"text": "Vulnerability CVE-2021-44228\nSeverity: CRITICAL\nPackage: org.apache.logging.log4j:log4j-core\nFixed Version: 2.15.0"},
              "properties": {"precision": "very-high", "security-severity": "10.0", "tags": ["vulnerability", "security", "CRITICAL"]}
            },
            {
              "id": "GHSA-jfh8-c2jp-5v3q",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {"text": "Remote code injection in Log4j"},
              "defaultConfiguration": {"level": "warning"},
              "helpUri": "https://github.com/advisories/GHSA-jfh8-c2jp-5v3q",
              "properties": {"precision": "very-high", "security-severity": "6.6", "tags": ["vulnerability", "security", "MEDIUM"]}
            },
            {
              "id": "DS002",
              "name": "Misconfiguration",
              "shortDescription": {"text": "Image user should not be 'root'"},
              "defaultConfiguration": {"level": "error"},
              "helpUri": "https://avd.aquasec.com/misconfig/ds002",
              "properties": {"precision": "very-high", "security-severity": "8.0", "tags": ["misconfiguration", "security", "HIGH"]}
            },
            {
              "id": "aws-access-key-id",
              "name": "Secret",
              "shortDescription": {"text": "AWS Access Key ID"},
              "defaultConfiguration": {"level": "error"},
              "properties": {"precision": "very-high", "security-severity": "9.5", "tags": ["secret", "security", "CRITICAL"]}
            }
          ],
          "version": "0.56.2"
        }
      },
      "results": [
        {
          "ruleId": "CVE-2021-44228",
          "ruleIndex": 0,
          "level": "error",
          "message": {"text": "Package: org.apache.logging.log4j:log4j-core\nInstalled Version: 2.14.1\nVulnerability CVE-2021-44228\nSeverity: CRITICAL\nFixed Version: 2.15.0"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "pom.xml", "uriBaseId": "ROOTPATH"}, "region": {"startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 1}}}]
        },
        {
          "ruleId": "GHSA-jfh8-c2jp-5v3q",
          "ruleIndex": 1,
          "level": "warning",
          "message": {"text": "Package: org.apache.logging.log4j:log4j-core\nInstalled Version: 2.14.1\nVulnerability GHSA-jfh8-c2jp-5v3q"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "pom.xml", "uriBaseId": "ROOTPATH"}, "region": {"startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 1}}}]
        },
        {
          "ruleId": "DS002",
          "ruleIndex": 2,
          "level": "error",
          "message": {"text": "Artifact: Dockerfile\nType: dockerfile\nVulnerability DS002\nSeverity: HIGH\nMessage: Specify at least 1 USER command in Dockerfile with non-root user as argument"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "Dockerfile", "uriBaseId": "ROOTPATH"}, "region": {"startLine": 1, "startColumn": 1, "endLine": 1, "endColumn": 1}}}]
        },
        {
          "ruleId": "aws-access-key-id",
          "ruleIndex": 3,
          "level": "error",
          "message": {"text": "Artifact: config/aws.env\nType: \nSecret AWS Access Key ID\nSeverity: CRITICAL\nMatch: AWS_ACCESS_KEY_ID=********************"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "config/aws.env", "uriBaseId": "ROOTPATH"}, "region": {"startLine": 3, "startColumn": 1, "endLine": 3, "endColumn": 1}}}]
        }
      ],
      "columnKind": "utf16CodeUnits",
      "originalUriBaseIds": {"ROOTPATH": {"uri": "file:///src/"}}
    }
  ]
}
