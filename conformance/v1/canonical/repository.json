{
  "description": "repositories: no scheme, no .git, no trailing slash, lower case",
  "cases": [
    {
      "type": "repository",
      "input": "https://github.com/Org/Repo",
      "expected": "github.com/org/repo"
    },
    {
      "type": "repository",
      "input": "http://github.com/Org/Repo/",
      "expected": "github.com/org/repo"
    },
    {
      "type": "repository",
      "input": "git@github.com:Org/Repo.git",
      "expected": "github.com/org/repo"
    },
    {
      "type": "repository",
      "input": "github.com/Org/Repo.git",
      "expected": "github.com/org/repo"
    },
    {
      "type": "repository",
      "input": "org/repo",
      "expected": "org/repo"
    }
  ]
}
