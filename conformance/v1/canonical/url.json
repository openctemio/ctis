{
  "description": "URL-like assets: scheme and host lower case, path and query case kept, trailing slash dropped",
  "cases": [
    {
      "type": "http_service",
      "input": "HTTPS://Example.COM:8443/",
      "expected": "https://example.com:8443"
    },
    {
      "type": "http_service",
      "input": "https://Example.com",
      "expected": "https://example.com"
    },
    {
      "type": "discovered_url",
      "input": "https://Example.COM/Admin/Login",
      "expected": "https://example.com/Admin/Login"
    },
    {
      "type": "discovered_url",
      "input": "https://Example.COM/Admin/Login?Next=/Home",
      "expected": "https://example.com/Admin/Login?Next=/Home"
    },
    {
      "type": "discovered_url",
      "input": "https://User:Pw@Example.com/P",
      "expected": "https://User:Pw@example.com/P"
    },
    {
      "type": "discovered_url",
      "input": "https://[2001:DB8::1]:8080/X",
      "expected": "https://[2001:db8::1]:8080/X"
    },
    {
      "type": "discovered_url",
      "input": "  https://Example.com/A/  ",
      "expected": "https://example.com/A"
    }
  ]
}
