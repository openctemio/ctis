{
  "description": "domain and subdomain: trimmed, lower case, no trailing dot",
  "cases": [
    {
      "type": "domain",
      "input": "Example.COM",
      "expected": "example.com"
    },
    {
      "type": "domain",
      "input": "example.com.",
      "expected": "example.com"
    },
    {
      "type": "domain",
      "input": " example.com ",
      "expected": "example.com"
    },
    {
      "type": "subdomain",
      "input": "API.Example.COM.",
      "expected": "api.example.com"
    },
    {
      "type": "subdomain",
      "input": "a.b.example.com",
      "expected": "a.b.example.com"
    },
    {
      "type": "domain",
      "input": "",
      "expected": ""
    },
    {
      "type": "domain",
      "input": "   ",
      "expected": ""
    }
  ]
}
