{
  "function": "CanonicalService",
  "description": "Services: <canonical host>:<port>/<transport>, an IPv6 host in brackets.",
  "vectors": [
    {
      "input": {
        "host": "Example.com",
        "port": 443,
        "transport": "TCP"
      },
      "output": "example.com:443/tcp"
    },
    {
      "input": {
        "host": "2001:db8::1",
        "port": 53,
        "transport": "udp"
      },
      "output": "[2001:db8::1]:53/udp"
    },
    {
      "input": {
        "host": "::ffff:192.0.2.1",
        "port": 22,
        "transport": "tcp"
      },
      "output": "192.0.2.1:22/tcp"
    },
    {
      "input": {
        "host": "example.com",
        "port": 0,
        "transport": "tcp"
      },
      "error": true
    },
    {
      "input": {
        "host": "example.com",
        "port": 80,
        "transport": "http"
      },
      "error": true,
      "note": "http is an application protocol, not a transport"
    },
    {
      "input": {
        "host": "Example.COM.",
        "port": 65535,
        "transport": " SCTP "
      },
      "output": "example.com:65535/sctp",
      "note": "host canonical, transport trimmed and lowercased"
    },
    {
      "input": {
        "host": "[2001:db8::1]",
        "port": 443,
        "transport": "tcp"
      },
      "output": "[2001:db8::1]:443/tcp",
      "note": "a bracketed address"
    },
    {
      "input": {
        "host": "fe80::1%eth0",
        "port": 22,
        "transport": "tcp"
      },
      "output": "[fe80::1]:22/tcp",
      "note": "the zone is dropped"
    },
    {
      "input": {
        "host": "bücher.example",
        "port": 443,
        "transport": "tcp"
      },
      "output": "xn--bcher-kva.example:443/tcp"
    },
    {
      "input": {
        "host": "192.168.001.010",
        "port": 22,
        "transport": "tcp"
      },
      "error": true
    },
    {
      "input": {
        "host": "example.com",
        "port": 65536,
        "transport": "tcp"
      },
      "error": true
    },
    {
      "input": {
        "host": "example.com",
        "port": 443,
        "transport": ""
      },
      "error": true,
      "note": "a transport is required"
    },
    {
      "input": {
        "host": "",
        "port": 443,
        "transport": "tcp"
      },
      "error": true
    }
  ]
}
