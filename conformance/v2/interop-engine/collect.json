{
  "description": "Passthrough and set rules (docs/mapping-engine.md, sections Set rules and Passthrough): an import mapping, a source document and the record pointers to inspect, to the passthrough of the report (the extension value, or null), the declared version, and per record the extension value and the members the set rules write (dotted names). Kept values are scrubbed: credential-named members and URL-like members with another scheme are dropped.",
  "cases": [
    {
      "name": "unmapped members: absolute on the report, relative on the record",
      "mapping": {
        "apiVersion": "openctem.io/interop/v1",
        "format": "example",
        "version": "1.0",
        "direction": "import",
        "namespace": "org.example.interop",
        "title": "Example 1.0",
        "detect": [
          {
            "pointer": "/kind",
            "equals": "example"
          }
        ],
        "version_pointer": "/specVersion",
        "records": [
          {
            "name": "result",
            "path": "/results[]",
            "kind": "finding"
          }
        ],
        "fields": [
          {
            "path": "/kind",
            "ignored": "detected only"
          },
          {
            "path": "/specVersion",
            "target": "passthrough version"
          },
          {
            "path": "/results",
            "target": "(container)"
          },
          {
            "path": "/results[]",
            "target": "findings[]"
          },
          {
            "path": "/results[]/ruleId",
            "set": "rule_id",
            "record": "result",
            "transform": [
              "trim"
            ]
          },
          {
            "path": "/results[]/level",
            "set": "severity",
            "record": "result",
            "transform": [
              "table:level"
            ]
          },
          {
            "path": "/results[]/kind",
            "set": "correlation_id",
            "record": "result",
            "transform": [
              "token"
            ]
          },
          {
            "path": "/results[]/text",
            "set": "title",
            "record": "result",
            "transform": [
              "line",
              "max_bytes:12"
            ]
          },
          {
            "path": "/results[]/score",
            "set": "rank",
            "record": "result"
          },
          {
            "path": "/results[]/conf",
            "set": "confidence",
            "record": "result"
          },
          {
            "path": "/results[]/viewer",
            "set": "hosted_viewer_uri",
            "record": "result",
            "transform": [
              "http_url"
            ]
          },
          {
            "path": "/results[]/upper",
            "set": "message",
            "record": "result",
            "transform": [
              "upper"
            ]
          },
          {
            "path": "/invocations",
            "ignored": "command lines and environments"
          }
        ],
        "tables": {
          "level": {
            "match": "fold",
            "map": {
              "error": "high",
              "warning": "medium",
              "note": "low"
            },
            "default": "info"
          }
        }
      },
      "document": {
        "kind": "example",
        "specVersion": "1.0",
        "runId": "r-7",
        "results": [
          {
            "ruleId": " R1 ",
            "level": "ERROR",
            "extra": {
              "a": [
                1,
                2
              ]
            },
            "note": "kept"
          }
        ]
      },
      "records": [
        "/results/0"
      ],
      "expected": {
        "records": {
          "/results/0": {
            "extension": {
              "unmapped": {
                "/extra": {
                  "a": [
                    1,
                    2
                  ]
                },
                "/note": "kept"
              },
              "version": "1.0"
            },
            "set": {
              "rule_id": "R1",
              "severity": "high"
            }
          }
        },
        "report": {
          "unmapped": {
            "/runId": "r-7"
          },
          "version": "1.0"
        },
        "version": "1.0"
      }
    },
