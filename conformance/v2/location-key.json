{
  "description": "LocationKey: a partial CTIS 2.0 finding object to the expected key. Branch order: pkg: (versionless purl; a package name alone has no key, the ecosystem is the purl type), url: from web.url then location.path, file:, net:<port>/<transport>, resource:.",
  "cases": [
    {
      "name": "purl without version",
      "finding": {
        "vulnerability": {
          "purl": "pkg:NPM/%40babel/core@7.0.0?arch=x#sub",
          "package_name": "x"
        }
      },
      "expected": "pkg:npm/%40babel/core"
    },
    {
      "name": "package name without purl has no package key",
      "finding": {
        "vulnerability": {
          "package_name": "lodash"
        }
      },
      "expected": ""
    },
    {
      "name": "package wins over web",
      "finding": {
        "vulnerability": {
          "package_name": "lodash",
          "purl": "pkg:npm/lodash@4.17.21"
        },
        "web": {
          "url": "https://example.com/a"
        }
      },
      "expected": "pkg:npm/lodash"
    },
    {
      "name": "web url",
      "finding": {
        "web": {
          "url": "HTTPS://Example.COM:443/Admin/Login"
        }
      },
      "expected": "url:https://example.com/Admin/Login"
    },
    {
      "name": "web url wins over location path",
      "finding": {
        "web": {
          "url": "https://example.com/a"
        },
        "location": {
          "path": "https://other.example/b"
        }
      },
      "expected": "url:https://example.com/a"
    },
    {
      "name": "web url wins over file path",
      "finding": {
        "web": {
          "url": "https://example.com/a"
        },
        "location": {
          "path": "src/app.py"
        }
      },
      "expected": "url:https://example.com/a"
    },
    {
      "name": "location path as url",
      "finding": {
        "location": {
          "path": "HTTPS://user:pw@Example.COM:443/a/b?q=1#frag"
        }
      },
      "expected": "url:https://example.com/a/b"
    },
    {
      "name": "url keeps a non default port",
      "finding": {
        "location": {
          "path": "http://example.com:8080"
        }
      },
      "expected": "url:http://example.com:8080/"
    },
    {
      "name": "url ipv6 default port",
      "finding": {
        "location": {
          "path": "http://[::1]:80/x"
        }
      },
      "expected": "url:http://[::1]/x"
    },
    {
      "name": "file",
      "finding": {
        "location": {
          "path": ".\\src\\..\\src\\app.py",
          "start_line": 9
        }
      },
      "expected": "file:src/app.py"
    },
    {
      "name": "network port",
      "finding": {
        "network": {
          "port": 22
        }
      },
      "expected": "net:22/tcp"
    },
    {
      "name": "network udp",
      "finding": {
        "network": {
          "port": 161,
          "transport": "udp"
        }
      },
      "expected": "net:161/udp"
    },
    {
      "name": "host level network",
      "finding": {
        "network": {}
      },
      "expected": "net:host"
    },
    {
      "name": "resource",
      "finding": {
        "misconfiguration": {
          "resource_type": "aws_s3_bucket",
          "resource_name": "logs"
        }
      },
      "expected": "resource:aws_s3_bucket/logs"
    },
    {
      "name": "no location",
      "finding": {},
      "expected": ""
    },
    {
      "name": "purl type is lowercased, name kept",
      "finding": {
        "vulnerability": {
          "purl": "pkg:PyPI/Django@4.2"
        }
      },
      "expected": "pkg:pypi/Django"
    },
    {
      "name": "golang purl namespace",
      "finding": {
        "vulnerability": {
          "purl": "pkg:golang/golang.org/x/net@v0.17.0"
        }
      },
      "expected": "pkg:golang/golang.org/x/net"
    },
    {
      "name": "maven purl",
      "finding": {
        "vulnerability": {
          "purl": "pkg:maven/org.apache.logging.log4j/log4j-core@2.14.1"
        }
      },
      "expected": "pkg:maven/org.apache.logging.log4j/log4j-core"
    }
  ]
}
