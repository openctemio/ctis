{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/openctemio/ctis/main/schemas/v1/dependency.json",
  "title": "CTIS Dependency",
  "description": "Software component or library dependency (SBOM)",
  "type": "object",
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the dependency within the report; other dependencies reference it in depends_on"
    },
    "name": {
      "type": "string",
      "description": "Component name"
    },
    "version": {
      "type": "string",
      "description": "Component version. Recommended; omit only when the version is genuinely unknown."
    },
    "type": {
      "type": "string",
      "description": "Component type (library, framework, application, os)"
    },
    "ecosystem": {
      "type": "string",
      "description": "Package ecosystem (npm, pypi, maven, gomod, etc.)"
    },
    "purl": {
      "type": "string",
      "description": "Package URL (PURL) identifier"
    },
    "uid": {
      "type": "string",
      "description": "Unique identifier from the scanner (e.g., Trivy UID)"
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of licenses"
    },
    "relationship": {
      "type": "string",
      "description": "Relationship to the project (direct, indirect, root, transit)"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of the dependencies this component depends on"
    },
    "path": {
      "type": "string",
      "description": "File path where defined (manifest file)"
    },
    "location": {
      "$ref": "finding.json#/$defs/FindingLocation"
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DependencyLocation"
      },
      "description": "All locations where this dependency is defined"
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Custom properties"
    }
  },
  "$defs": {
    "DependencyLocation": {
      "type": "object",
      "description": "A place where the dependency is declared",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "File path"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "description": "Start line number"
        },
        "end_line": {
          "type": "integer",
          "minimum": 1,
          "description": "End line number"
        },
        "start_column": {
          "type": "integer",
          "minimum": 1,
          "description": "Start column number"
        },
        "end_column": {
          "type": "integer",
          "minimum": 1,
          "description": "End column number"
        }
      }
    }
  }
}
