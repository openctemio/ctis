{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/openctemio/ctis/main/schemas/v1/finding.json",
  "title": "CTIS Finding",
  "description": "Security finding schema for CTEM Ingest Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "severity"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier within the report"
    },
    "type": {
      "$ref": "#/$defs/FindingType"
    },
    "title": {
      "type": "string",
      "description": "Short title"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "message": {
      "type": "string",
      "description": "Primary message to display (the main human-readable finding message). If not set, title will be used as the message."
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence score (0-100)"
    },
    "impact": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "description": "Impact level for risk assessment"
    },
    "likelihood": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Likelihood level for risk assessment"
    },
    "category": {
      "type": "string",
      "description": "Finding category/class"
    },
    "vulnerability_class": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Vulnerability classes (e.g., SQL Injection, XSS)"
    },
    "subcategory": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Subcategories (e.g., audit, vuln, secure default)"
    },
    "rule_id": {
      "type": "string",
      "description": "Rule/check ID that detected this finding"
    },
    "rule_name": {
      "type": "string",
      "description": "Rule name"
    },
    "asset_ref": {
      "type": "string",
      "description": "Reference to asset ID within this report"
    },
    "asset_value": {
      "type": "string",
      "description": "Direct asset value (if not using asset_ref)"
    },
    "asset_type": {
      "$ref": "asset.json#/$defs/AssetType"
    },
    "location": {
      "$ref": "#/$defs/FindingLocation"
    },
    "network": {
      "$ref": "#/$defs/NetworkLocation"
    },
    "evidence": {
      "type": "string",
      "description": "Scanner raw proof/output for this finding (e.g. Nessus plugin_output)"
    },
    "vulnerability": {
      "$ref": "#/$defs/VulnerabilityDetails"
    },
    "secret": {
      "$ref": "#/$defs/SecretDetails"
    },
    "misconfiguration": {
      "$ref": "#/$defs/MisconfigurationDetails"
    },
    "compliance": {
      "$ref": "#/$defs/ComplianceDetails"
    },
    "web3": {
      "$ref": "web3-finding.json"
    },
    "remediation": {
      "$ref": "#/$defs/Remediation"
    },
    "references": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "description": "Reference URLs"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "fingerprint": {
      "type": "string",
      "description": "Producer-computed identity of this finding for deduplication, stable across scans. Send a lowercase hex SHA-256 (64 characters); OpenCTEM ignores values that are not hex of at least 16 characters and computes its own. See docs/spec.md, Fingerprints, for the recipe per finding type."
    },
    "partial_fingerprints": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Contributing identity components for fingerprint calculation"
    },
    "correlation_id": {
      "type": "string",
      "description": "Groups logically identical results across runs"
    },
    "baseline_state": {
      "type": "string",
      "enum": ["new", "unchanged", "updated", "absent"],
      "description": "Status relative to previous scan (SARIF baselineState)"
    },
    "kind": {
      "type": "string",
      "enum": ["not_applicable", "pass", "fail", "review", "open", "informational"],
      "description": "Evaluation state of the finding (SARIF kind)"
    },
    "rank": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Priority/importance score (0-100, SARIF rank)"
    },
    "occurrence_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of times this result was observed"
    },
    "related_locations": {
      "type": "array",
      "items": {"$ref": "#/$defs/FindingLocation"},
      "description": "Additional locations related to this finding"
    },
    "stacks": {
      "type": "array",
      "items": {"$ref": "#/$defs/StackTrace"},
      "description": "Call stacks relevant to the finding"
    },
    "attachments": {
      "type": "array",
      "items": {"$ref": "#/$defs/Attachment"},
      "description": "Relevant artifacts or evidence files"
    },
    "work_item_uris": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "description": "URIs of work items (issues, tickets) associated with this finding"
    },
    "hosted_viewer_uri": {
      "type": "string",
      "format": "uri",
      "description": "URI to view this finding in a hosted viewer"
    },
    "status": {
      "$ref": "#/$defs/FindingStatus"
    },
    "data_flow": {
      "$ref": "#/$defs/DataFlow"
    },
    "suppression": {
      "$ref": "#/$defs/Suppression"
    },
    "exposure": {
      "$ref": "#/$defs/FindingExposure"
    },
    "remediation_context": {
      "$ref": "#/$defs/RemediationContext"
    },
    "business_impact": {
      "$ref": "#/$defs/BusinessImpact"
    },
    "author": {
      "type": "string",
      "description": "Git author name"
    },
    "author_email": {
      "type": "string",
      "format": "email",
      "description": "Git author email"
    },
    "commit_date": {
      "type": "string",
      "format": "date-time",
      "description": "Git commit date"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "native": {
      "$ref": "#/$defs/NativeIdentity"
    },
    "scores": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/Score"},
      "description": "Every score of the finding with its source and date (CVSS v3.1 and v4.0 together, vendor scores, EPSS, SSVC). vulnerability.cvss_* stays the primary CVSS score."
    },
    "vex": {
      "$ref": "#/$defs/VEX"
    },
    "source_lifecycle": {
      "$ref": "#/$defs/SourceLifecycle"
    },
    "attack": {
      "type": "array",
      "maxItems": 20,
      "description": "MITRE ATT&CK techniques the finding enables (T1190, T1595.002) (1.5)",
      "items": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"}
    },
    "source_extra": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {"type": "string", "maxLength": 4096},
      "description": "Source fields no CTIS member holds, as strings. At most 64 entries, keys of 128 characters, values of 4096, 32 KiB in all (the total is checked by receivers)."
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "NativeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "The finding as the source tool names it. The normalized values stay in severity, status and source_lifecycle.state.",
      "properties": {
        "scheme": {
          "type": "string",
          "enum": ["nessus", "qualys", "defectdojo", "sarif", "other"],
          "description": "Vocabulary of the native values"
        },
        "vuln_id": {"type": "string", "maxLength": 256, "description": "Tool id of the vulnerability or check: Nessus plugin ID, Qualys QID, DefectDojo vuln_id_from_tool, SARIF rule id"},
        "instance_id": {"type": "string", "maxLength": 256, "description": "Tool id of this occurrence (DefectDojo unique_id_from_tool, a detection id)"},
        "family": {"type": "string", "maxLength": 256, "description": "Tool family or category of the check"},
        "severity": {"type": "string", "maxLength": 64, "description": "Severity exactly as the tool reported it (\"4\", \"5\", \"High\", \"error\")"},
        "status": {"type": "string", "maxLength": 64, "description": "Status exactly as the tool reported it (\"Re-Opened\", \"fixed\", \"risk_accepted\")"},
        "detection_type": {
          "type": "string",
          "enum": ["confirmed", "potential", "info"],
          "description": "Whether the tool confirmed the issue, only suspects it, or gathered information"
        },
        "credentialed": {"type": "boolean", "description": "The scan was authenticated on the target. Absent means unknown."},
        "raw_ref": {"type": "string", "maxLength": 1024, "description": "Where the raw record can be found again (a URL into the source, a locator in the imported file). Receivers never fetch it."}
      }
    },
    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "description": "One score with its source and date. cvss needs version (2.0, 3.0, 3.1, 4.0) and a value or a vector; cvss and vpr values are 0-10, epss and epss_percentile 0-1 (FIRST fractions); ssvc has no value and needs a vector or a label.",
      "properties": {
        "system": {
          "type": "string",
          "enum": ["cvss", "epss", "epss_percentile", "ssvc", "vpr", "vendor"]
        },
        "version": {"type": "string", "maxLength": 32},
        "vector": {"type": "string", "maxLength": 512},
        "value": {"type": "number"},
        "label": {"type": "string", "maxLength": 32, "description": "Qualitative rating as the source states it"},
        "source": {"type": "string", "maxLength": 64, "description": "Who assigned it: nvd, ghsa, vendor, tenable, qualys, first, cisa, ..."},
        "as_of": {"type": "string", "format": "date-time"}
      }
    },
    "VEX": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "Exploitability statement (CSAF / OpenVEX vocabulary). not_affected needs a justification or a statement; a justification is only for not_affected.",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_affected", "affected", "fixed", "under_investigation"]
        },
        "justification": {
          "type": "string",
          "enum": ["component_not_present", "vulnerable_code_not_present", "vulnerable_code_not_in_execute_path", "vulnerable_code_cannot_be_controlled_by_adversary", "inline_mitigations_already_exist"]
        },
        "native_justification": {"type": "string", "maxLength": 64, "description": "The justification as the source document states it (a CycloneDX analysis.justification)"},
        "statement": {"type": "string", "maxLength": 4096, "description": "Impact or action statement, plain text"},
        "source": {"type": "string", "maxLength": 512, "description": "Who made the statement: a document id or URL, a vendor, a team"},
        "as_of": {"type": "string", "format": "date-time"}
      }
    },
    "SourceLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "description": "The finding's history as the source tracks it, separate from the receiver's own lifecycle",
      "properties": {
        "first_found": {"type": "string", "format": "date-time"},
        "last_found": {"type": "string", "format": "date-time"},
        "last_fixed": {"type": "string", "format": "date-time"},
        "times_found": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "state": {
          "type": "string",
          "enum": ["new", "active", "reopened", "fixed"]
        }
      }
    },
    "VulnerabilityID": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "description": "One identifier of a vulnerability with its namespace",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["cve", "ghsa", "osv", "vendor"]
        },
        "id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+\\-]*$"},
        "source": {"type": "string", "maxLength": 64, "description": "Issuer of a vendor id (redhat, microsoft, ...)"}
      }
    },
    "Advisory": {
      "type": "object",
      "additionalProperties": false,
      "description": "A vendor advisory that addresses the finding (an id or a url)",
      "properties": {
        "id": {"type": "string", "maxLength": 128},
        "url": {"type": "string", "maxLength": 2048, "format": "uri"},
        "source": {"type": "string", "maxLength": 64}
      }
    },
    "FindingType": {
      "type": "string",
      "enum": ["vulnerability", "secret", "misconfiguration", "compliance", "web3"],
      "description": "Finding type"
    },
    "Severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"],
      "description": "Severity level"
    },
    "FindingStatus": {
      "type": "string",
      "enum": ["open", "resolved", "suppressed", "false_positive", "accepted_risk", "in_progress"],
      "description": "Finding status"
    },
    "FindingLocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Location information for code-based findings",
      "properties": {
        "path": {"type": "string", "description": "File path"},
        "start_line": {"type": "integer", "minimum": 1, "description": "Start line (1-indexed)"},
        "end_line": {"type": "integer", "minimum": 1},
        "start_column": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 1},
        "snippet": {"type": "string", "description": "Code snippet"},
        "context_snippet": {"type": "string", "description": "Broader context snippet"},
        "branch": {"type": "string", "description": "Git branch"},
        "commit_sha": {"type": "string", "description": "Git commit SHA"},
        "logical_location": {"$ref": "#/$defs/LogicalLocation"},
        "context_start_line": {"type": "integer", "minimum": 1, "description": "Line where context_snippet starts"}
      }
    },
    "NetworkLocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where a network/host finding was observed (Nessus/Tenable and other network scanners)",
      "properties": {
        "host": {"type": "string", "description": "Host the finding was observed on (IP or hostname)"},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535, "description": "Port number; 0 or absent means not port-specific"},
        "protocol": {"type": "string", "description": "Transport protocol: tcp, udp"},
        "service": {"type": "string", "description": "Service on the port: https, ssh, smb, mysql, ..."}
      }
    },
    "LogicalLocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Logical location within code structure",
      "properties": {
        "name": {"type": "string", "description": "Symbol name (function, class, method)"},
        "kind": {
          "type": "string",
          "enum": ["function", "method", "class", "module", "namespace", "type", "property"],
          "description": "Symbol kind"
        },
        "fully_qualified_name": {"type": "string", "description": "Fully qualified name"},
        "parent_index": {"type": "integer", "minimum": 0, "description": "Index of the enclosing logical location (SARIF logicalLocation.parentIndex)"}
      }
    },
    "DataFlow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Taint tracking data flow from source to sink (SARIF codeFlows)",
      "properties": {
        "sources": {
          "type": "array",
          "items": {"$ref": "#/$defs/DataFlowLocation"},
          "description": "Taint source locations (where untrusted data enters)"
        },
        "intermediates": {
          "type": "array",
          "items": {"$ref": "#/$defs/DataFlowLocation"},
          "description": "Intermediate propagation steps"
        },
        "sinks": {
          "type": "array",
          "items": {"$ref": "#/$defs/DataFlowLocation"},
          "description": "Taint sink locations (where data reaches dangerous function)"
        },
        "sanitizers": {
          "type": "array",
          "items": {"$ref": "#/$defs/DataFlowLocation"},
          "description": "Sanitizer locations (where data is cleaned/escaped)"
        },
        "tainted": {
          "type": "boolean",
          "description": "Whether data is still tainted at the sink (false if properly sanitized)"
        },
        "taint_type": {
          "type": "string",
          "enum": ["user_input", "file_read", "env_var", "network", "database", "header", "cookie", "session", "argv", "external"],
          "description": "Type of taint origin"
        },
        "vulnerability_type": {
          "type": "string",
          "enum": ["sql_injection", "xss", "command_injection", "path_traversal", "ssrf", "ldap_injection", "xpath_injection", "code_injection", "template_injection", "deserialization", "open_redirect", "log_injection", "header_injection", "xxe", "regex_dos"],
          "description": "Vulnerability type this flow leads to"
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Flow confidence score (0-100)"
        },
        "interprocedural": {
          "type": "boolean",
          "description": "Whether flow crosses function boundaries"
        },
        "cross_file": {
          "type": "boolean",
          "description": "Whether data flows across multiple files"
        },
        "call_path": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Call graph path (function names in order)"
        },
        "summary": {
          "type": "string",
          "description": "Human-readable summary of the flow"
        }
      }
    },
    "DataFlowLocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Location in data flow trace (SARIF threadFlowLocation)",
      "properties": {
        "path": {"type": "string", "description": "File path"},
        "line": {"type": "integer", "minimum": 1, "description": "Line number (1-indexed)"},
        "end_line": {"type": "integer", "minimum": 1, "description": "End line for multi-line spans"},
        "column": {"type": "integer", "minimum": 1, "description": "Column number (1-indexed)"},
        "end_column": {"type": "integer", "minimum": 1, "description": "End column"},
        "content": {"type": "string", "description": "Code content at this location"},
        "label": {"type": "string", "description": "Variable or expression name being tracked"},
        "index": {"type": "integer", "minimum": 0, "description": "Step index in the flow (0-indexed)"},
        "type": {
          "type": "string",
          "enum": ["source", "sink", "propagator", "sanitizer", "transform"],
          "description": "Location type in the flow"
        },
        "function": {"type": "string", "description": "Function/method name containing this location"},
        "class": {"type": "string", "description": "Class/struct name (if applicable)"},
        "module": {"type": "string", "description": "Module/namespace"},
        "operation": {
          "type": "string",
          "description": "Operation performed: assignment, call, return, parameter, concat, etc."
        },
        "called_function": {"type": "string", "description": "For function calls: the function being called"},
        "parameter_index": {"type": "integer", "minimum": 0, "description": "For parameters: the parameter index (0-indexed)"},
        "taint_state": {
          "type": "string",
          "enum": ["tainted", "sanitized", "unknown"],
          "description": "Taint state at this location"
        },
        "transformation": {
          "type": "string",
          "description": "Transformation applied: encode, decode, escape, hash, encrypt, etc."
        },
        "notes": {"type": "string", "description": "Notes for human understanding"}
      }
    },
    "Suppression": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finding suppression information (follows SARIF suppression: kind + status)",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["in_source", "external"],
          "description": "in_source: suppressed by a comment or annotation in the code; external: suppressed outside the code (a baseline file, a scanner console)"
        },
        "status": {
          "type": "string",
          "enum": ["accepted", "under_review", "rejected"],
          "description": "Review state of the suppression"
        },
        "reason": {"type": "string", "description": "Short reason code or phrase (false_positive, test_code, risk_accepted, ...)"},
        "justification": {"type": "string", "description": "Detailed justification"},
        "suppressed_by": {"type": "string", "description": "Who suppressed (user/email)"},
        "suppressed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time", "description": "When suppression expires"}
      }
    },
    "VulnerabilityDetails": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vulnerability-specific details",
      "properties": {
        "cve_id": {
          "type": "string",
          "pattern": "^CVE-\\d{4}-\\d+$",
          "description": "CVE identifier"
        },
        "cve_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CVE-\\d{4}-\\d+$"},
          "description": "All CVEs for this finding (network scanners group multiple per plugin)"
        },
        "vpr_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Tenable Vulnerability Priority Rating (0-10)"
        },
        "cwe_id": {
          "type": "string",
          "pattern": "^CWE-\\d+$",
          "description": "Primary CWE identifier"
        },
        "cwe_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CWE-\\d+$"},
          "description": "All related CWE identifiers"
        },
        "owasp_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^A\\d{2}:\\d{4}"},
          "description": "OWASP Top 10 identifiers (e.g., A01:2021, A03:2021)"
        },
        "asvs": {
          "$ref": "#/$defs/ASVSInfo"
        },
        "cvss_version": {
          "type": "string",
          "enum": ["2.0", "3.0", "3.1", "4.0"]
        },
        "cvss_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "cvss_vector": {"type": "string"},
        "cvss_source": {
          "type": "string",
          "enum": ["nvd", "ghsa", "redhat", "bitnami", "vendor"],
          "description": "Source of CVSS score"
        },
        "package": {"type": "string", "description": "Affected package"},
        "purl": {"type": "string", "description": "Package URL (purl spec)"},
        "affected_version": {"type": "string"},
        "affected_version_range": {"type": "string", "description": "Affected version range, e.g. \">=1.0.0, <1.2.5\""},
        "fixed_version": {"type": "string"},
        "fixed_versions": {
          "type": "array",
          "items": {"type": "string"},
          "description": "All versions that fix the vulnerability"
        },
        "advisories": {
          "type": "array",
          "items": {"type": "string", "format": "uri"},
          "description": "Advisory URLs"
        },
        "is_direct": {"type": "boolean", "description": "The vulnerable package is a direct dependency (not transitive)"},
        "ecosystem": {
          "type": "string",
          "enum": ["npm", "pip", "maven", "gradle", "nuget", "cargo", "go", "composer", "rubygems", "hex", "pub", "swift", "cocoapods"]
        },
        "dependency_path": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Dependency path from root to vulnerable package"
        },
        "exploit_available": {"type": "boolean"},
        "exploit_maturity": {
          "type": "string",
          "enum": ["none", "poc", "functional", "weaponized"]
        },
        "in_cisa_kev": {"type": "boolean", "description": "In CISA Known Exploited Vulnerabilities"},
        "epss_score": {"type": "number", "minimum": 0, "maximum": 1, "description": "EPSS probability of exploitation in the next 30 days, 0-1 (FIRST scale)"},
        "epss_percentile": {"type": "number", "minimum": 0, "maximum": 1, "description": "EPSS percentile as a fraction 0-1, exactly as FIRST publishes it (0.97 = 97th percentile). Do not send 0-100."},
        "cpe": {"type": "string"},
        "published_at": {"type": "string", "format": "date-time", "description": "Vulnerability published date"},
        "modified_at": {"type": "string", "format": "date-time", "description": "Vulnerability last modified date"},
        "data_source": {
          "$ref": "#/$defs/VulnDataSource"
        },
        "severity_source": {"type": "string", "description": "Source of severity rating (nvd, ghsa, redhat, etc.)"},
        "vendor_severity": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5},
          "description": "Per-vendor severity mapping (vendor name -> severity level 1-5)"
        },
        "layer": {
          "$ref": "#/$defs/ContainerLayer"
        },
        "avd_id": {"type": "string", "pattern": "^AVD-[A-Z]+-\\d+$", "description": "Aqua Vulnerability Database ID"},
        "vuln_status": {
          "type": "string",
          "enum": ["affected", "fixed", "under_investigation", "will_not_fix"],
          "description": "Vulnerability status"
        },
        "ids": {
          "type": "array",
          "maxItems": 64,
          "items": {"$ref": "#/$defs/VulnerabilityID"},
          "description": "Every id of the vulnerability with its namespace (CVE, GHSA, OSV, vendor)"
        }
      }
    },
    "VulnDataSource": {
      "type": "object",
      "additionalProperties": false,
      "description": "Vulnerability data source information",
      "properties": {
        "id": {"type": "string", "description": "Data source ID (nvd, ghsa, osv, etc.)"},
        "name": {"type": "string", "description": "Data source name"},
        "url": {"type": "string", "format": "uri", "description": "Data source URL"}
      }
    },
    "ASVSInfo": {
      "type": "object",
      "additionalProperties": false,
      "description": "OWASP ASVS (Application Security Verification Standard) compliance info",
      "properties": {
        "section": {
          "type": "string",
          "description": "ASVS section (e.g., V2: Authentication)"
        },
        "control_id": {
          "type": "string",
          "description": "Control ID (e.g., 2.1.1)"
        },
        "control_url": {
          "type": "string",
          "format": "uri",
          "description": "Link to ASVS documentation for this control"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "description": "ASVS level (1, 2, or 3)"
        }
      }
    },
    "ContainerLayer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Container layer information for image scans",
      "properties": {
        "digest": {"type": "string", "description": "Layer digest (sha256:...)"},
        "diff_id": {"type": "string", "description": "Layer diff ID"}
      }
    },
    "SecretDetails": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secret-specific details",
      "properties": {
        "secret_type": {
          "type": "string",
          "enum": ["api_key", "password", "token", "certificate", "private_key", "oauth", "jwt", "ssh_key", "aws_key", "gcp_key", "azure_key", "generic_secret", "database_credential", "encryption_key"]
        },
        "service": {
          "type": "string",
          "description": "Associated service (aws, github, stripe, etc.)"
        },
        "masked_value": {
          "type": "string",
          "description": "Masked value (first/last chars)"
        },
        "length": {"type": "integer", "minimum": 1},
        "entropy": {"type": "number", "minimum": 0},
        "valid": {"type": "boolean", "description": "Secret is valid (if verified)"},
        "verified_at": {"type": "string", "format": "date-time", "description": "When validity was checked"},
        "revoked": {"type": "boolean"},
        "revoked_at": {"type": "string", "format": "date-time", "description": "When the secret was revoked"},
        "scopes": {
          "type": "array",
          "items": {"type": "string"},
          "description": "API scopes/permissions associated with the secret"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the secret expires"
        },
        "rotation_due_at": {
          "type": "string",
          "format": "date-time",
          "description": "When secret rotation is due"
        },
        "in_history_only": {
          "type": "boolean",
          "description": "Secret only exists in git history (not current code)"
        },
        "age_in_days": {"type": "integer", "minimum": 0, "description": "Age of the secret in days, if known"},
        "commit_count": {"type": "integer", "minimum": 0, "description": "Number of commits the secret appears in"}
      }
    },
    "MisconfigurationDetails": {
      "type": "object",
      "additionalProperties": false,
      "description": "Misconfiguration-specific details",
      "properties": {
        "policy_id": {"type": "string"},
        "policy_name": {"type": "string"},
        "avd_id": {"type": "string", "pattern": "^AVD-[A-Z]+-\\d+$", "description": "Aqua Vulnerability Database ID"},
        "resource_type": {"type": "string"},
        "resource_name": {"type": "string"},
        "provider": {"type": "string", "description": "Cloud provider (AWS, GCP, Azure)"},
        "service": {"type": "string", "description": "Service name (S3, EC2, IAM)"},
        "namespace": {"type": "string", "description": "Policy namespace (builtin.aws.s3)"},
        "query": {"type": "string", "description": "Rego query path"},
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "cause": {"type": "string"}
      }
    },
    "ComplianceDetails": {
      "type": "object",
      "additionalProperties": false,
      "description": "Compliance-specific details",
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["pci-dss", "hipaa", "soc2", "cis", "nist", "iso27001", "gdpr", "fedramp"]
        },
        "framework_version": {"type": "string"},
        "control_id": {"type": "string"},
        "control_name": {"type": "string"},
        "control_description": {"type": "string"},
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "manual", "not_applicable"]
        }
      }
    },
    "Remediation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Remediation guidance",
      "properties": {
        "recommendation": {"type": "string"},
        "steps": {
          "type": "array",
          "items": {"type": "string"}
        },
        "effort": {
          "type": "string",
          "enum": ["trivial", "low", "medium", "high"]
        },
        "fix_available": {"type": "boolean"},
        "auto_fixable": {"type": "boolean"},
        "fix_code": {
          "type": "string",
          "description": "Suggested fix code - the actual code to replace the vulnerable code (for SAST auto-fix)"
        },
        "fix_regex": {
          "$ref": "#/$defs/FixRegex"
        },
        "references": {
          "type": "array",
          "items": {"type": "string", "format": "uri"}
        },
        "solution_type": {
          "type": "string",
          "enum": ["patch", "upgrade", "config", "workaround", "mitigation", "no_fix"],
          "description": "Kind of fix"
        },
        "patch_published_at": {"type": "string", "format": "date-time", "description": "When the vendor published the patch"},
        "advisories": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/Advisory"},
          "description": "Vendor advisories that address the finding"
        }
      }
    },
    "FixRegex": {
      "type": "object",
      "additionalProperties": false,
      "description": "Regex-based auto-fix pattern (for tools like Semgrep)",
      "properties": {
        "regex": {
          "type": "string",
          "description": "Regular expression pattern to match"
        },
        "replacement": {
          "type": "string",
          "description": "Replacement string (may contain capture group references like $1, $2)"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of replacements to make (0 = all)"
        }
      }
    },
    "StackTrace": {
      "type": "object",
      "additionalProperties": false,
      "description": "Call stack trace (SARIF stack)",
      "properties": {
        "message": {"type": "string", "description": "Stack description"},
        "frames": {
          "type": "array",
          "items": {"$ref": "#/$defs/StackFrame"},
          "description": "Stack frames from innermost to outermost"
        }
      }
    },
    "StackFrame": {
      "type": "object",
      "additionalProperties": false,
      "description": "Single frame in a call stack",
      "properties": {
        "location": {"$ref": "#/$defs/FindingLocation"},
        "module": {"type": "string", "description": "Module/library name"},
        "thread_id": {"type": "integer"},
        "parameters": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Function parameters"
        }
      }
    },
    "Attachment": {
      "type": "object",
      "additionalProperties": false,
      "description": "Artifact or evidence attachment (SARIF attachment)",
      "properties": {
        "description": {"type": "string"},
        "artifact_location": {"$ref": "#/$defs/ArtifactLocation"},
        "regions": {
          "type": "array",
          "items": {"$ref": "#/$defs/FindingLocation"},
          "description": "Relevant regions within the artifact"
        }
      }
    },
    "ArtifactLocation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Location of an artifact (SARIF artifactLocation)",
      "properties": {
        "uri": {"type": "string", "format": "uri-reference", "description": "Absolute or relative URI of the artifact"},
        "uri_base_id": {"type": "string", "description": "Base URI id the uri is relative to"},
        "index": {"type": "integer", "minimum": 0, "description": "Index within the producer's artifacts list"}
      }
    },
    "FindingExposure": {
      "type": "object",
      "additionalProperties": false,
      "description": "CTEM exposure information for a finding",
      "properties": {
        "vector": {
          "type": "string",
          "enum": ["network", "local", "physical", "adjacent_net"],
          "description": "Exposure vector"
        },
        "is_network_accessible": {
          "type": "boolean",
          "description": "Is the finding reachable from the network"
        },
        "is_internet_accessible": {
          "type": "boolean",
          "description": "Is the finding directly reachable from the internet"
        },
        "attack_prerequisites": {
          "type": "string",
          "description": "Prerequisites for exploitation: auth_required, mfa_required, local_access, etc."
        }
      }
    },
    "RemediationContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "CTEM remediation context for a finding",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["patch", "upgrade", "workaround", "config_change", "mitigate", "accept_risk"],
          "description": "Remediation type"
        },
        "estimated_minutes": {
          "type": "integer",
          "minimum": 0,
          "description": "Estimated time to fix in minutes"
        },
        "complexity": {
          "type": "string",
          "enum": ["simple", "moderate", "complex"],
          "description": "Fix complexity"
        },
        "remedy_available": {
          "type": "boolean",
          "description": "Is a remedy (patch/fix) available"
        }
      }
    },
    "BusinessImpact": {
      "type": "object",
      "additionalProperties": false,
      "description": "CTEM business impact assessment for a finding",
      "properties": {
        "data_exposure_risk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "critical"],
          "description": "Data exposure risk level"
        },
        "reputational_impact": {
          "type": "boolean",
          "description": "Has potential reputational impact"
        },
        "compliance_impact": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Compliance frameworks impacted: PCI-DSS, HIPAA, SOC2, GDPR, ISO27001"
        }
      }
    }
  }
}
