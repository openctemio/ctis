{
  "apiVersion": "openctem.io/interop/v1",
  "format": "csaf",
  "version": "2.0",
  "direction": "import",
  "namespace": "org.ctis.interop.csaf",
  "title": "CSAF 2.0 (VEX and security advisory profiles)",
  "source": "CSAF 2.0 JSON (csaf_vex, csaf_security_advisory, csaf_base)",
  "version_pointer": "/document/csaf_version",
  "detect": [{"pointer": "/document/csaf_version", "matches": "\\S"}],
  "notes": [
    "This mapping reads CSAF 2.0 documents (the VEX and security advisory profiles); a document of a later 2.x version is read with it, and the members it adds are kept as passthrough.",
    "A CSAF document describes products, not findings: the report has no assets or findings, and Result.VEX holds one statement per vulnerability, product_status group and statement text.",
    "Status groups: known_not_affected is not_affected; known_affected, first_affected and last_affected are affected; fixed, first_fixed and recommended are fixed; under_investigation is under_investigation.",
    "not_affected: the justification is the label of a flag that names the product (directly or through a product group); the statement is the details of an impact threat for the product. A not_affected product with neither is left out with an issue: a bare claim never suppresses a finding.",
    "affected and fixed: the statement is the remediation for the product (`category: details (url)`). Nothing is invented when there is none.",
    "Products are resolved through the product tree: branches (any depth; a product_version branch gives the version), full_product_names, and relationships (the platform, with the component in products[].subcomponents). PURL and CPE come from product_identification_helper; a product without them keeps its name.",
    "Product ids the tree does not define, and relationships that refer to undefined or circular products, are left out with an issue.",
    "Statement source: publisher.namespace#tracking.id; as_of: tracking.current_release_date.",
    "Links in the document (sbom_urls, x_generic_uris, references) are never fetched."
  ],
  "hooks": ["csaf.document", "csaf.product_tree", "csaf.vex", "csaf.vulnerabilities"],
  "fields": [
    {"path": "/document", "target": "(container)"},
    {"path": "/document/category", "target": "metadata.properties.category", "hook": "csaf.document"},
    {"path": "/document/csaf_version", "target": "metadata.properties.csaf_version", "hook": "csaf.document"},
    {"path": "/document/title", "target": "metadata.properties.title", "hook": "csaf.document"},
    {"path": "/document/lang", "ignored": "document language"},
    {"path": "/document/source_lang", "ignored": "language of a translated document's source"},
    {"path": "/document/publisher", "target": "(container)"},
    {"path": "/document/publisher/name", "target": "metadata.properties.publisher", "hook": "csaf.document"},
    {"path": "/document/publisher/namespace", "target": "vex[].vex.source, metadata.properties.publisher_namespace", "hook": "csaf.document"},
    {"path": "/document/publisher/category", "ignored": "kind of publisher (vendor, coordinator, ...)"},
    {"path": "/document/publisher/contact_details", "ignored": "publisher contact (personal data)"},
    {"path": "/document/publisher/issuing_authority", "ignored": "publisher's authority statement (prose)"},
    {"path": "/document/tracking", "target": "(container)"},
    {"path": "/document/tracking/id", "target": "metadata.source_refs[], vex[].vex.source", "hook": "csaf.document"},
    {"path": "/document/tracking/version", "target": "metadata.properties.document_version", "hook": "csaf.document"},
    {"path": "/document/tracking/status", "target": "metadata.properties.document_status", "hook": "csaf.document"},
    {"path": "/document/tracking/current_release_date", "target": "vex[].vex.as_of, metadata.properties.current_release_date", "hook": "csaf.document"},
    {"path": "/document/tracking/initial_release_date", "target": "metadata.properties.initial_release_date", "hook": "csaf.document"},
    {"path": "/document/tracking/aliases", "ignored": "other ids of the document"},
    {"path": "/document/tracking/aliases[]", "ignored": "other ids of the document"},
    {"path": "/document/tracking/generator*/**", "ignored": "the tool that wrote the document"},
    {"path": "/document/tracking/generator", "ignored": "the tool that wrote the document"},
    {"path": "/document/tracking/revision_history*/**", "ignored": "revision log of the document"},
    {"path": "/document/tracking/revision_history", "ignored": "revision log of the document"},
    {"path": "/document/distribution", "target": "(container)"},
    {"path": "/document/distribution/text", "ignored": "distribution prose; the TLP label is kept"},
    {"path": "/document/distribution/tlp", "target": "(container)"},
    {"path": "/document/distribution/tlp/label", "target": "metadata.properties.tlp", "hook": "csaf.document"},
    {"path": "/document/distribution/tlp/url", "ignored": "link to the TLP definition"},
    {"path": "/document/aggregate_severity", "target": "(container)"},
    {"path": "/document/aggregate_severity/text", "target": "metadata.properties.aggregate_severity", "hook": "csaf.document"},
    {"path": "/document/aggregate_severity/namespace", "ignored": "namespace of the severity text"},
    {"path": "/document/notes", "ignored": "advisory prose; statements carry the per-product text"},
    {"path": "/document/notes*/**", "ignored": "advisory prose; statements carry the per-product text"},
    {"path": "/document/references", "ignored": "links about the advisory; never fetched"},
    {"path": "/document/references*/**", "ignored": "links about the advisory; never fetched"},
    {"path": "/document/acknowledgments", "ignored": "names of people and organizations (personal data)"},
    {"path": "/document/acknowledgments*/**", "ignored": "names of people and organizations (personal data)"},
    {"path": "/product_tree", "target": "(container)"},
    {"path": "/product_tree/**/branches", "target": "(container)"},
    {"path": "/product_tree/**/branches[]", "target": "(container)"},
    {"path": "/product_tree/**/branches[]/category", "target": "vex[].products[].version (a product_version branch)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/**/branches[]/name", "target": "vex[].products[].version (a product_version branch; vendor and product names are in the product name)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/**/branches[]/product", "target": "(container)"},
    {"path": "/product_tree/**/branches[]/product/name", "target": "vex[].products[].name", "hook": "csaf.product_tree"},
    {"path": "/product_tree/**/branches[]/product/product_id", "target": "(product id the statements refer to)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/full_product_names", "target": "(container)"},
    {"path": "/product_tree/full_product_names[]", "target": "(container)"},
    {"path": "/product_tree/full_product_names[]/name", "target": "vex[].products[].name", "hook": "csaf.product_tree"},
    {"path": "/product_tree/full_product_names[]/product_id", "target": "(product id the statements refer to)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/relationships", "target": "(container)"},
    {"path": "/product_tree/relationships[]", "target": "(container)"},
    {"path": "/product_tree/relationships[]/category", "target": "vex[].products[].subcomponents (every category: the component inside the platform)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/relationships[]/product_reference", "target": "vex[].products[].subcomponents[]", "hook": "csaf.product_tree"},
    {"path": "/product_tree/relationships[]/relates_to_product_reference", "target": "vex[].products[] (the platform: its PURL or CPE when the relationship has none)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/relationships[]/full_product_name", "target": "(container)"},
    {"path": "/product_tree/relationships[]/full_product_name/name", "target": "vex[].products[].name", "hook": "csaf.product_tree"},
    {"path": "/product_tree/relationships[]/full_product_name/product_id", "target": "(product id the statements refer to)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/product_groups", "target": "(container)"},
    {"path": "/product_tree/product_groups[]", "target": "(container)"},
    {"path": "/product_tree/product_groups[]/group_id", "target": "(group id flags, threats and remediations refer to)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/product_groups[]/product_ids", "target": "(container)"},
    {"path": "/product_tree/product_groups[]/product_ids[]", "target": "(the products of the group)", "hook": "csaf.product_tree"},
    {"path": "/product_tree/product_groups[]/summary", "ignored": "description of the group"},
    {"path": "/product_tree/**/product_identification_helper", "target": "(container)"},
    {"path": "/product_tree/**/product_identification_helper/purl", "target": "vex[].products[].purl", "hook": "csaf.product_tree"},
    {"path": "/product_tree/**/product_identification_helper/cpe", "target": "vex[].products[].cpe", "hook": "csaf.product_tree"},
    {"path": "/product_tree/**/product_identification_helper/hashes", "ignored": "file hashes; findings are matched on PURL and CPE"},
    {"path": "/product_tree/**/product_identification_helper/hashes*/**", "ignored": "file hashes; findings are matched on PURL and CPE"},
    {"path": "/product_tree/**/product_identification_helper/model_numbers", "ignored": "hardware model numbers; no CTIS member"},
    {"path": "/product_tree/**/product_identification_helper/model_numbers[]", "ignored": "hardware model numbers; no CTIS member"},
    {"path": "/product_tree/**/product_identification_helper/serial_numbers", "ignored": "hardware serial numbers; no CTIS member"},
    {"path": "/product_tree/**/product_identification_helper/serial_numbers[]", "ignored": "hardware serial numbers; no CTIS member"},
    {"path": "/product_tree/**/product_identification_helper/skus", "ignored": "stock keeping units; no CTIS member"},
    {"path": "/product_tree/**/product_identification_helper/skus[]", "ignored": "stock keeping units; no CTIS member"},
    {"path": "/product_tree/**/product_identification_helper/sbom_urls", "ignored": "links to SBOMs; never fetched"},
    {"path": "/product_tree/**/product_identification_helper/sbom_urls[]", "ignored": "links to SBOMs; never fetched"},
    {"path": "/product_tree/**/product_identification_helper/x_generic_uris", "ignored": "other identifiers by URI; never fetched"},
    {"path": "/product_tree/**/product_identification_helper/x_generic_uris*/**", "ignored": "other identifiers by URI; never fetched"},
    {"path": "/vulnerabilities", "target": "(container)"},
    {"path": "/vulnerabilities[]", "target": "vex[] (one statement per status group and statement text)", "hook": "csaf.vulnerabilities"},
    {"path": "/vulnerabilities[]/cve", "target": "vex[].vulnerability_ids (cve)", "hook": "csaf.vulnerabilities"},
    {"path": "/vulnerabilities[]/ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/ids[]", "target": "(container)"},
    {"path": "/vulnerabilities[]/ids[]/text", "target": "vex[].vulnerability_ids", "hook": "csaf.vulnerabilities"},
    {"path": "/vulnerabilities[]/ids[]/system_name", "target": "vex[].vulnerability_ids[].source (vendor ids)", "hook": "csaf.vulnerabilities"},
    {"path": "/vulnerabilities[]/product_status", "target": "(container)"},
    {"path": "/vulnerabilities[]/product_status/*", "target": "vex[].vex.status (by group)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/product_status/*[]", "target": "vex[].products", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/flags", "target": "(container)"},
    {"path": "/vulnerabilities[]/flags[]", "target": "(container)"},
    {"path": "/vulnerabilities[]/flags[]/label", "target": "vex[].vex.justification, native_justification", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/flags[]/product_ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/flags[]/product_ids[]", "target": "(products the justification is for)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/flags[]/group_ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/flags[]/group_ids[]", "target": "(product groups the justification is for)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/flags[]/date", "ignored": "date of the flag; the document date is the statement date"},
    {"path": "/vulnerabilities[]/threats", "target": "(container)"},
    {"path": "/vulnerabilities[]/threats[]", "target": "(container)"},
    {"path": "/vulnerabilities[]/threats[]/category", "target": "(impact threats give the not_affected statement)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/threats[]/details", "target": "vex[].vex.statement (not_affected)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/threats[]/product_ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/threats[]/product_ids[]", "target": "(products the threat is for)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/threats[]/group_ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/threats[]/group_ids[]", "target": "(product groups the threat is for)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/threats[]/date", "ignored": "date of the threat; the document date is the statement date"},
    {"path": "/vulnerabilities[]/remediations", "target": "(container)"},
    {"path": "/vulnerabilities[]/remediations[]", "target": "(container)"},
    {"path": "/vulnerabilities[]/remediations[]/category", "target": "vex[].vex.statement (affected, fixed)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/remediations[]/details", "target": "vex[].vex.statement (affected, fixed)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/remediations[]/url", "target": "vex[].vex.statement (affected, fixed); never fetched", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/remediations[]/product_ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/remediations[]/product_ids[]", "target": "(products the remediation is for)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/remediations[]/group_ids", "target": "(container)"},
    {"path": "/vulnerabilities[]/remediations[]/group_ids[]", "target": "(product groups the remediation is for)", "hook": "csaf.vex"},
    {"path": "/vulnerabilities[]/remediations[]/date", "ignored": "date of the remediation"},
    {"path": "/vulnerabilities[]/remediations[]/entitlements", "ignored": "who may get the fix (licensing prose)"},
    {"path": "/vulnerabilities[]/remediations[]/entitlements[]", "ignored": "who may get the fix (licensing prose)"},
    {"path": "/vulnerabilities[]/remediations[]/restart_required", "ignored": "operational detail of applying the fix"},
    {"path": "/vulnerabilities[]/remediations[]/restart_required*/**", "ignored": "operational detail of applying the fix"},
    {"path": "/vulnerabilities[]/scores", "ignored": "per-product CVSS of the advisory; a statement carries no scores, and the receiver's findings keep their own"},
    {"path": "/vulnerabilities[]/scores*/**", "ignored": "per-product CVSS of the advisory; a statement carries no scores, and the receiver's findings keep their own"},
    {"path": "/vulnerabilities[]/cwe", "ignored": "weakness of the vulnerability; a statement carries no weakness"},
    {"path": "/vulnerabilities[]/cwe*/**", "ignored": "weakness of the vulnerability; a statement carries no weakness"},
    {"path": "/vulnerabilities[]/title", "ignored": "vulnerability title (advisory prose)"},
    {"path": "/vulnerabilities[]/notes", "ignored": "vulnerability prose; statements carry the per-product text"},
    {"path": "/vulnerabilities[]/notes*/**", "ignored": "vulnerability prose; statements carry the per-product text"},
    {"path": "/vulnerabilities[]/references", "ignored": "links about the vulnerability; never fetched"},
    {"path": "/vulnerabilities[]/references*/**", "ignored": "links about the vulnerability; never fetched"},
    {"path": "/vulnerabilities[]/acknowledgments", "ignored": "names of people and organizations (personal data)"},
    {"path": "/vulnerabilities[]/acknowledgments*/**", "ignored": "names of people and organizations (personal data)"},
    {"path": "/vulnerabilities[]/involvements", "ignored": "coordination log of the parties"},
    {"path": "/vulnerabilities[]/involvements*/**", "ignored": "coordination log of the parties"},
    {"path": "/vulnerabilities[]/discovery_date", "ignored": "when the vulnerability was discovered"},
    {"path": "/vulnerabilities[]/release_date", "ignored": "when the vulnerability was published"}
  ]
}
