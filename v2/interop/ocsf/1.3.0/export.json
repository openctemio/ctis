{
  "apiVersion": "openctem.io/interop/v1",
  "format": "ocsf",
  "version": "1.3.0",
  "direction": "export",
  "namespace": "org.ctis.interop.ocsf",
  "title": "OCSF 1.3.0 (Findings: Vulnerability Finding, Compliance Finding)",
  "source": "OCSF schema 1.3.0, classes 2002 and 2003",
  "notes": [
    "Every member the exporter can write is listed here; the adapter test checks it against the output types. Export writes the events as one JSON array; Events returns them as values.",
    "OCSF has no importer in this module, so no passthrough is written back. Accepted losses are listed in docs/exporters.md and testdata/export/*.losses.json."
  ],
  "tables": {
    "severity": {"default": "0|Unknown", "map": {"critical": "5|Critical", "high": "4|High", "info": "1|Informational", "low": "2|Low", "medium": "3|Medium"}},
    "status": {"default": "0|", "map": {"accepted_risk": "99|Accepted Risk", "false_positive": "99|False Positive", "in_progress": "2|In Progress", "open": "1|New", "resolved": "4|Resolved", "suppressed": "3|Suppressed"}}
  },
  "hooks": ["ocsf.compliance", "ocsf.event", "ocsf.finding_info", "ocsf.remediation", "ocsf.resource", "ocsf.vulnerabilities"],
  "fields": [
    {"path": "/[]", "target": "one event per finding, in report order", "hook": "ocsf.event"},
    {"path": "/[]/activity_id", "target": "3 (Close) for status resolved, else 1 (Create)", "hook": "ocsf.event"},
    {"path": "/[]/activity_name", "target": "the activity", "hook": "ocsf.event"},
    {"path": "/[]/category_name", "target": "\"Findings\"", "hook": "ocsf.event"},
    {"path": "/[]/category_uid", "target": "2 (Findings)", "hook": "ocsf.event"},
    {"path": "/[]/class_name", "target": "the class", "hook": "ocsf.event"},
    {"path": "/[]/class_uid", "target": "2002 Vulnerability Finding (vulnerability, weakness, secret, exposure, malware, license), 2003 Compliance Finding (compliance, misconfiguration)", "hook": "ocsf.event"},
    {"path": "/[]/compliance", "target": "compliance, misconfiguration", "hook": "ocsf.compliance"},
    {"path": "/[]/compliance/control", "target": "compliance.control_id, misconfiguration.policy_id", "hook": "ocsf.compliance"},
    {"path": "/[]/compliance/standards", "target": "compliance.framework, misconfiguration.provider", "hook": "ocsf.compliance"},
    {"path": "/[]/compliance/standards[]", "target": "compliance.framework, misconfiguration.provider", "hook": "ocsf.compliance"},
    {"path": "/[]/compliance/status", "target": "the compliance kind", "hook": "ocsf.compliance"},
    {"path": "/[]/compliance/status_id", "target": "compliance kind (pass 1, fail 3, else 99)", "hook": "ocsf.compliance"},
    {"path": "/[]/confidence_score", "target": "confidence", "hook": "ocsf.event"},
    {"path": "/[]/finding_info", "target": "finding identity and timing", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/analytic", "target": "rule_id, rule_name", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/analytic/name", "target": "rule_name, asset name, tool name or package name", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/analytic/type", "target": "analytic type Rule, or the asset type", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/analytic/type_id", "target": "(container)"},
    {"path": "/[]/finding_info/analytic/uid", "target": "the id of that object (fingerprint, rule_id, asset id, CVE, CWE)", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/desc", "target": "description", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/first_seen_time", "target": "first_seen_at (epoch ms)", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/last_seen_time", "target": "last_seen_at (epoch ms)", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/title", "target": "title (else rule_id), or the vulnerability title", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/types", "target": "category", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/types[]", "target": "category", "hook": "ocsf.finding_info"},
    {"path": "/[]/finding_info/uid", "target": "the id of that object (fingerprint, rule_id, asset id, CVE, CWE)", "hook": "ocsf.finding_info"},
    {"path": "/[]/message", "target": "message", "hook": "ocsf.event"},
    {"path": "/[]/metadata", "target": "metadata", "hook": "ocsf.event"},
    {"path": "/[]/metadata/product", "target": "tool", "hook": "ocsf.event"},
    {"path": "/[]/metadata/product/name", "target": "rule_name, asset name, tool name or package name", "hook": "ocsf.event"},
    {"path": "/[]/metadata/product/url_string", "target": "tool.info_url", "hook": "ocsf.event"},
    {"path": "/[]/metadata/product/vendor_name", "target": "tool.vendor", "hook": "ocsf.event"},
    {"path": "/[]/metadata/product/version", "target": "metadata.version 1.3.0, tool.version, CVSS or package version", "hook": "ocsf.event"},
    {"path": "/[]/metadata/version", "target": "metadata.version 1.3.0, tool.version, CVSS or package version", "hook": "ocsf.event"},
    {"path": "/[]/remediation", "target": "remediation.recommendation, references", "hook": "ocsf.remediation"},
    {"path": "/[]/remediation/desc", "target": "description", "hook": "ocsf.remediation"},
    {"path": "/[]/remediation/references", "target": "references", "hook": "ocsf.remediation"},
    {"path": "/[]/remediation/references[]", "target": "references", "hook": "ocsf.remediation"},
    {"path": "/[]/resources", "target": "the finding's asset", "hook": "ocsf.resource"},
    {"path": "/[]/resources[]", "target": "the finding's asset", "hook": "ocsf.resource"},
    {"path": "/[]/resources[]/name", "target": "rule_name, asset name, tool name or package name", "hook": "ocsf.resource"},
    {"path": "/[]/resources[]/type", "target": "analytic type Rule, or the asset type", "hook": "ocsf.resource"},
    {"path": "/[]/resources[]/uid", "target": "the id of that object (fingerprint, rule_id, asset id, CVE, CWE)", "hook": "ocsf.resource"},
    {"path": "/[]/severity", "target": "severity caption (table severity)", "hook": "ocsf.event"},
    {"path": "/[]/severity_id", "target": "severity (table severity)", "hook": "ocsf.event"},
    {"path": "/[]/status", "target": "status caption (table status)", "hook": "ocsf.event"},
    {"path": "/[]/status_id", "target": "status (table status)", "hook": "ocsf.event"},
    {"path": "/[]/time", "target": "last_seen_at, else first_seen_at, else Options.Time, else metadata.generated_at (epoch ms)", "hook": "ocsf.event"},
    {"path": "/[]/type_name", "target": "the type", "hook": "ocsf.event"},
    {"path": "/[]/type_uid", "target": "class_uid x 100 + activity_id", "hook": "ocsf.event"},
    {"path": "/[]/unmapped", "target": "members OCSF has no place for", "hook": "ocsf.event"},
    {"path": "/[]/unmapped/*", "target": "ctis_type (type), compliance_framework_version, secret_type, secret_service, secret_masked_value (masked)", "hook": "ocsf.event"},
    {"path": "/[]/vulnerabilities", "target": "vulnerability details", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]", "target": "vulnerability details", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code", "target": "location", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code[]", "target": "location", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code[]/end_line", "target": "location.end_line", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code[]/file", "target": "location.path", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code[]/file/name", "target": "rule_name, asset name, tool name or package name", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code[]/file/path", "target": "location.path", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_code[]/start_line", "target": "location.start_line", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_packages", "target": "vulnerability.package_name, installed_version, purl, first of fixed_versions", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_packages[]", "target": "vulnerability.package_name, installed_version, purl, first of fixed_versions", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_packages[]/fixed_in_version", "target": "the first fixed version", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_packages[]/name", "target": "rule_name, asset name, tool name or package name", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_packages[]/purl", "target": "vulnerability.purl", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/affected_packages[]/version", "target": "metadata.version 1.3.0, tool.version, CVSS or package version", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve", "target": "one CVE of vulnerability.ids", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/cvss", "target": "scores cvss", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/cvss[]", "target": "scores cvss", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/cvss[]/base_score", "target": "the CVSS score", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/cvss[]/vector_string", "target": "the CVSS vector", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/cvss[]/version", "target": "metadata.version 1.3.0, tool.version, CVSS or package version", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/epss", "target": "scores epss, epss_percentile", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/epss/percentile", "target": "the EPSS percentile", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/epss/score", "target": "the EPSS score", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cve/uid", "target": "the id of that object (fingerprint, rule_id, asset id, CVE, CWE)", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cwe", "target": "vulnerability.cwe_ids", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/cwe/uid", "target": "the id of that object (fingerprint, rule_id, asset id, CVE, CWE)", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/desc", "target": "description", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/is_exploit_available", "target": "a kev, exploited_in_wild, public_exploit or weaponized threat signal", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/references", "target": "references", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/references[]", "target": "references", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/remediation", "target": "remediation.recommendation, references", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/remediation/desc", "target": "description", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/remediation/references", "target": "references", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/remediation/references[]", "target": "references", "hook": "ocsf.vulnerabilities"},
    {"path": "/[]/vulnerabilities[]/severity", "target": "(container)"},
    {"path": "/[]/vulnerabilities[]/title", "target": "title (else rule_id), or the vulnerability title", "hook": "ocsf.vulnerabilities"}
  ]
}
