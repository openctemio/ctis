    {"path": "/components[]/properties[]/name", "target": "name", "hook": "cyclonedx.components"},
    {"path": "/components[]/properties[]/value", "target": "the property value", "hook": "cyclonedx.components"},
    {"path": "/components[]/publisher", "target": "property publisher", "hook": "cyclonedx.components"},
