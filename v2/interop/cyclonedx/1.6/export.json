{
  "apiVersion": "openctem.io/interop/v1",
  "format": "cyclonedx",
  "version": "1.6",
  "direction": "export",
  "namespace": "org.ctis.interop.cyclonedx",
  "title": "CycloneDX 1.6 JSON (BOM with vulnerabilities)",
  "source": "CycloneDX 1.6 JSON",
  "notes": [
    "Every member the exporter can write is listed here (the adapter test checks it against the output types); the document members kept on import under extensions[\"org.ctis.interop.cyclonedx\"] are written back only where this list leaves a place free and only when their pointer crosses no array index (the exporter orders components and vulnerabilities its own way).",
    "Only findings of type vulnerability are part of a BOM. Accepted losses are listed in docs/exporters.md and testdata/export/*.losses.json."
  ],
  "tables": {
    "cvss_method": {"default": "other", "map": {"2.0": "CVSSv2", "3.0": "CVSSv3", "3.1": "CVSSv31", "4.0": "CVSSv4"}},
    "hash_alg": {"map": {"blake2b-256": "BLAKE2b-256", "blake2b-384": "BLAKE2b-384", "blake2b-512": "BLAKE2b-512", "blake3": "BLAKE3", "md5": "MD5", "sha-1": "SHA-1", "sha-256": "SHA-256", "sha-384": "SHA-384", "sha-512": "SHA-512", "sha3-256": "SHA3-256", "sha3-384": "SHA3-384", "sha3-512": "SHA3-512"}},
    "justification": {"map": {"code_not_present": "code_not_present", "code_not_reachable": "code_not_reachable", "protected_at_perimeter": "protected_at_perimeter", "protected_at_runtime": "protected_at_runtime", "protected_by_compiler": "protected_by_compiler", "protected_by_mitigating_control": "protected_by_mitigating_control", "requires_configuration": "requires_configuration", "requires_dependency": "requires_dependency", "requires_environment": "requires_environment"}, "match": "fold"},
    "justification_of_ctis": {"map": {"component_not_present": "code_not_present", "inline_mitigations_already_exist": "protected_by_mitigating_control", "vulnerable_code_cannot_be_controlled_by_adversary": "requires_environment", "vulnerable_code_not_in_execute_path": "code_not_reachable", "vulnerable_code_not_present": "code_not_present"}},
    "rating_severity": {"map": {"critical": "critical", "high": "high", "info": "info", "low": "low", "medium": "medium", "none": "none", "unknown": "unknown"}},
    "vex_state": {"map": {"affected": "exploitable", "fixed": "resolved", "not_affected": "not_affected", "under_investigation": "in_triage"}}
  },
  "hooks": ["cyclonedx.components", "cyclonedx.document", "cyclonedx.graph", "cyclonedx.vex", "cyclonedx.vulnerabilities"],
  "reemit_from": ["1.4", "1.5"],
  "fields": [
    {"path": "/bomFormat", "target": "\"CycloneDX\"", "hook": "cyclonedx.document"},
    {"path": "/components", "target": "(container)"},
    {"path": "/components[]", "target": "dependencies[] in first-seen order", "hook": "cyclonedx.components"},
    {"path": "/components[]/bom-ref", "target": "id, else purl, else name@version (the subject: the asset id)", "hook": "cyclonedx.components"},
    {"path": "/components[]/cpe", "target": "property cpe", "hook": "cyclonedx.components"},
    {"path": "/components[]/description", "target": "property description", "hook": "cyclonedx.components"},
