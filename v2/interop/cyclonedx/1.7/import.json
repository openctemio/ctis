{
  "apiVersion": "openctem.io/interop/v1",
  "format": "cyclonedx",
  "version": "1.7",
  "direction": "import",
  "namespace": "org.ctis.interop.cyclonedx",
  "title": "CycloneDX JSON (SBOM, VDR, VEX)",
  "source": "CycloneDX 1.4, 1.5 and 1.6 JSON",
  "version_pointer": "/specVersion",
  "detect": [{"pointer": "/specVersion", "matches": "^1\\.([6-9]|[1-9][0-9]+)$"}],
  "notes": [
    "This mapping reads CycloneDX 1.6 and later 1.x documents: members a later minor adds are kept as passthrough until a mapping for that version lists them.",
    "The subject (metadata.component) is the asset: value is its purl, else name@version; a container with an image reference is a container_image, a component with a package URL is a package, anything else is unclassified. Without a subject, an unclassified asset named after the serial number holds the components and findings, and an issue says so. A BOM without components or findings (a pure VEX) creates no asset.",
    "Every other component, at any nesting depth, is a dependency of the subject: id is its bom-ref (else purl, else name@version); a second component with a used bom-ref is skipped with an issue. depends_on keeps only refs that name a component; relationship is direct when the subject depends on it, transitive when the BOM has a dependency graph.",
    "One finding per vulnerability and affected component of this BOM (affects[].ref naming a component, or the subject). A ref that is a package URL outside the BOM is a VEX product but no finding.",
    "Severity: the severity word of the newest CVSS rating (else the first rating with one; a CVSS score without a word is banded 9/7/4/0.1); without any, medium with a note in source_extra. Every rating goes to scores (CVSSv2/v3/v31/v4 as cvss with version, SSVC as ssvc, others as vendor).",
    "analysis maps through ctis.NormalizeVEXStatus and NormalizeVEXJustification. It becomes finding.vex and one VEX statement per vulnerability whose products are the affected components (purl, cpe, name, version). A not_affected analysis without a known justification or a detail is refused (issue). No finding is made for not_affected, resolved, resolved_with_pedigree and false_positive; they count as skipped.",
    "The VEX source is the BOM serial number.",
    "People's names and contacts (authors, credits, supplier contacts, annotations) are not read. Proof-of-concept material is not copied."
  ],
  "fold": [{"from": "/metadata/component/components[]", "to": "/components[]"}, {"from": "/components[]/components[]", "to": "/components[]"}],
  "hooks": ["cyclonedx.components", "cyclonedx.document", "cyclonedx.graph", "cyclonedx.vex", "cyclonedx.vulnerabilities"],
  "fields": [
    {"path": "/bomFormat", "target": "format detection (must be CycloneDX)", "hook": "cyclonedx.document"},
    {"path": "/$schema", "ignored": "schema location"},
    {"path": "/specVersion", "target": "metadata.properties.cyclonedx_spec_version", "hook": "cyclonedx.document"},
    {"path": "/serialNumber", "target": "metadata.properties.bom_serial_number, findings[].vex.source, vex[].vex.source", "hook": "cyclonedx.document"},
    {"path": "/version", "target": "metadata.properties.bom_version", "hook": "cyclonedx.document"},
    {"path": "/metadata", "target": "(container)"},
    {"path": "/metadata/timestamp", "target": "metadata.properties.bom_timestamp", "hook": "cyclonedx.document"},
    {"path": "/metadata/tools/**", "ignored": "the tools that wrote the BOM"},
    {"path": "/metadata/tools[]/**", "ignored": "the tools that wrote the BOM"},
    {"path": "/metadata/authors", "ignored": "people's names and contacts"},
    {"path": "/metadata/authors[]/**", "ignored": "people's names and contacts"},
    {"path": "/metadata/manufacture/**", "ignored": "manufacturer contact details"},
    {"path": "/metadata/manufacturer/**", "ignored": "manufacturer contact details"},
    {"path": "/metadata/supplier/**", "ignored": "supplier contact details"},
    {"path": "/metadata/licenses/**", "ignored": "license of the BOM document itself"},
    {"path": "/metadata/properties/**", "ignored": "producer-specific properties of the BOM document"},
    {"path": "/metadata/lifecycles/**", "ignored": "product lifecycle phase the BOM was made in"},
    {"path": "/components", "target": "(container)"},
    {"path": "/metadata/component", "target": "assets[] (the subject of the BOM)", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/bom-ref", "target": "vulnerabilities[].affects[].ref resolution to the subject", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/type", "target": "assets[].type (container; operating-system, device, firmware, platform: host; else repository), assets[].properties.component_type", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/group", "target": "assets[].name (group/name)", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/name", "target": "assets[].name, assets[].value (name@version when no purl)", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/version", "target": "assets[].value, assets[].properties.version", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/purl", "target": "assets[].value", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/cpe", "target": "assets[].properties.cpe", "hook": "cyclonedx.components"},
    {"path": "/metadata/component/components", "target": "(container)"},
    {"path": "/metadata/component/description", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/scope", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/hashes", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/hashes[]/**", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/licenses", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/licenses[]/**", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/supplier/**", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/publisher", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/properties", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/properties[]/**", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/externalReferences/**", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/author", "ignored": "a person's name"},
    {"path": "/metadata/component/authors/**", "ignored": "people's names and contacts"},
    {"path": "/metadata/component/manufacturer/**", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/metadata/component/copyright", "ignored": "the subject keeps its identity (name, version, purl, cpe, type); its other details describe the product, not the scanned asset"},
    {"path": "/components[]", "target": "dependencies[]", "hook": "cyclonedx.components"},
    {"path": "/components[]/bom-ref", "target": "dependencies[].id, vulnerabilities[].affects[].ref resolution", "hook": "cyclonedx.components"},
    {"path": "/components[]/type", "target": "dependencies[].type", "hook": "cyclonedx.components"},
    {"path": "/components[]/group", "target": "dependencies[].properties.group, findings[].vulnerability.package_name (group/name)", "hook": "cyclonedx.components"},
    {"path": "/components[]/name", "target": "dependencies[].name, findings[].vulnerability.package_name", "hook": "cyclonedx.components"},
    {"path": "/components[]/version", "target": "dependencies[].version, findings[].vulnerability.installed_version", "hook": "cyclonedx.components"},
    {"path": "/components[]/description", "target": "dependencies[].properties.description", "hook": "cyclonedx.components"},
    {"path": "/components[]/scope", "target": "dependencies[].properties.scope", "hook": "cyclonedx.components"},
    {"path": "/components[]/purl", "target": "dependencies[].purl, findings[].vulnerability.purl", "hook": "cyclonedx.components"},
    {"path": "/components[]/cpe", "target": "dependencies[].properties.cpe, findings[].vulnerability.cpe", "hook": "cyclonedx.components"},
    {"path": "/components[]/hashes", "target": "(container)"},
    {"path": "/components[]/hashes[]", "target": "(container)"},
    {"path": "/components[]/hashes[]/alg", "target": "dependencies[].properties.hash_<alg> (key)", "hook": "cyclonedx.components"},
    {"path": "/components[]/hashes[]/content", "target": "dependencies[].properties.hash_<alg>", "hook": "cyclonedx.components"},
    {"path": "/components[]/licenses", "target": "(container)"},
    {"path": "/components[]/licenses[]", "target": "(container)"},
    {"path": "/components[]/licenses[]/license", "target": "(container)"},
    {"path": "/components[]/licenses[]/license/id", "target": "dependencies[].licenses", "hook": "cyclonedx.components"},
    {"path": "/components[]/licenses[]/license/name", "target": "dependencies[].licenses (when no id)", "hook": "cyclonedx.components"},
    {"path": "/components[]/licenses[]/license/url", "ignored": "license text location; the id or name is kept"},
    {"path": "/components[]/licenses[]/license/text/**", "ignored": "license text; the id or name is kept"},
    {"path": "/components[]/licenses[]/license/acknowledgement", "ignored": "declared or concluded; the license is kept either way"},
    {"path": "/components[]/licenses[]/expression", "target": "dependencies[].licenses", "hook": "cyclonedx.components"},
    {"path": "/components[]/supplier", "target": "(container)"},
    {"path": "/components[]/supplier/name", "target": "dependencies[].properties.supplier", "hook": "cyclonedx.components"},
    {"path": "/components[]/supplier/url", "ignored": "supplier web site"},
    {"path": "/components[]/supplier/url[]", "ignored": "supplier web site"},
    {"path": "/components[]/supplier/contact[]/**", "ignored": "people's names, e-mail addresses and phone numbers"},
    {"path": "/components[]/supplier/contact", "ignored": "people's names, e-mail addresses and phone numbers"},
    {"path": "/components[]/publisher", "target": "dependencies[].properties.publisher", "hook": "cyclonedx.components"},
    {"path": "/components[]/author", "ignored": "a person's name"},
    {"path": "/components[]/authors/**", "ignored": "people's names and contacts"},
    {"path": "/components[]/manufacturer/**", "ignored": "manufacturer contact details"},
    {"path": "/components[]/copyright", "ignored": "copyright notice text"},
    {"path": "/components[]/properties", "target": "(container)"},
    {"path": "/components[]/properties[]", "target": "(container)"},
    {"path": "/components[]/properties[]/name", "target": "dependencies[].properties.property:<name> (key)", "hook": "cyclonedx.components"},
    {"path": "/components[]/properties[]/value", "target": "dependencies[].properties.property:<name>", "hook": "cyclonedx.components"},
    {"path": "/components[]/components", "target": "(container)"},
    {"path": "/components[]/externalReferences", "ignored": "links to the project (VCS, web site, issue tracker); not a property of the installed component"},
    {"path": "/components[]/externalReferences[]/**", "ignored": "links to the project (VCS, web site, issue tracker); not a property of the installed component"},
    {"path": "/components[]/evidence/**", "ignored": "how the producer found the component (occurrences, call stacks); can hold build paths"},
    {"path": "/components[]/pedigree/**", "ignored": "ancestors and patches of the component; not imported"},
    {"path": "/components[]/swid/**", "ignored": "SWID tag; purl and cpe identify the component"},
    {"path": "/components[]/omniborId", "ignored": "artifact id; purl identifies the component"},
    {"path": "/components[]/omniborId[]", "ignored": "artifact id; purl identifies the component"},
    {"path": "/components[]/swhid", "ignored": "artifact id; purl identifies the component"},
    {"path": "/components[]/swhid[]", "ignored": "artifact id; purl identifies the component"},
    {"path": "/components[]/mime-type", "ignored": "file type of a file component"},
    {"path": "/components[]/modified", "ignored": "deprecated flag (use pedigree)"},
    {"path": "/components[]/tags", "ignored": "free-form labels of the producer"},
    {"path": "/components[]/tags[]", "ignored": "free-form labels of the producer"},
    {"path": "/components[]/releaseNotes/**", "ignored": "release notes text"},
    {"path": "/components[]/modelCard/**", "ignored": "machine-learning model card"},
    {"path": "/components[]/data/**", "ignored": "data set description"},
    {"path": "/components[]/cryptoProperties/**", "ignored": "cryptographic asset inventory (CBOM); not imported"},
    {"path": "/components[]/signature/**", "ignored": "signature of the component entry"},
    {"path": "/dependencies", "target": "(container)"},
    {"path": "/dependencies[]", "target": "(container)"},
    {"path": "/dependencies[]/ref", "target": "dependencies[] (the dependent); dependencies[].relationship (direct when the subject depends on it)", "hook": "cyclonedx.graph"},
    {"path": "/dependencies[]/dependsOn", "target": "(container)"},
    {"path": "/dependencies[]/dependsOn[]", "target": "dependencies[].depends_on (refs that name a component)", "hook": "cyclonedx.graph"},
    {"path": "/dependencies[]/provides", "ignored": "specifications a component implements (CBOM)"},
    {"path": "/dependencies[]/provides[]", "ignored": "specifications a component implements (CBOM)"},
    {"path": "/vulnerabilities", "target": "(container)"},
    {"path": "/vulnerabilities[]", "target": "findings[] (one per affected component of this BOM), vex[] (with an analysis)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/bom-ref", "target": "findings[].native.instance_id", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/id", "target": "findings[].rule_id, native.vuln_id, vulnerability.ids; vex[].vulnerability_ids", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/source", "target": "(container)"},
    {"path": "/vulnerabilities[]/source/name", "target": "findings[].vulnerability.data_source.name", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/source/url", "target": "findings[].vulnerability.data_source.url, references", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/references", "target": "(container)"},
    {"path": "/vulnerabilities[]/references[]", "target": "(container)"},
    {"path": "/vulnerabilities[]/references[]/id", "target": "findings[].vulnerability.ids; vex[].vulnerability_ids", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/references[]/source", "target": "(container)"},
    {"path": "/vulnerabilities[]/references[]/source/name", "target": "findings[].vulnerability.ids[].source (vendor ids)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/references[]/source/url", "ignored": "the id is kept; the database link is derived from it"},
    {"path": "/vulnerabilities[]/ratings", "target": "(container)"},
    {"path": "/vulnerabilities[]/ratings[]", "target": "findings[].scores[]", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/ratings[]/source", "target": "(container)"},
    {"path": "/vulnerabilities[]/ratings[]/source/name", "target": "findings[].scores[].source", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/ratings[]/source/url", "ignored": "the source name is kept"},
    {"path": "/vulnerabilities[]/ratings[]/score", "target": "findings[].scores[].value, scores[] (cvss), severity (when no severity word)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/ratings[]/severity", "target": "findings[].severity (from the newest CVSS rating), native.severity, scores[].label", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/ratings[]/method", "target": "findings[].scores[].system and version (CVSSv2, CVSSv3, CVSSv31, CVSSv4, SSVC; others vendor)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/ratings[]/vector", "target": "findings[].scores[].vector, scores[] (cvss)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/ratings[]/justification", "target": "findings[].source_extra.rating_justification:<source>:<method>", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/cwes", "target": "(container)"},
    {"path": "/vulnerabilities[]/cwes[]", "target": "findings[].vulnerability.cwe_ids", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/description", "target": "findings[].description, message", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/detail", "target": "findings[].description", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/recommendation", "target": "findings[].remediation.recommendation", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/workaround", "target": "findings[].remediation.steps, solution_type workaround (when no recommendation)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/proofOfConcept/**", "ignored": "reproduction steps and exploit material; not copied into findings"},
    {"path": "/vulnerabilities[]/advisories", "target": "(container)"},
    {"path": "/vulnerabilities[]/advisories[]", "target": "findings[].remediation.advisories", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/advisories[]/title", "target": "findings[].remediation.advisories[].id", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/advisories[]/url", "target": "findings[].remediation.advisories[].url, references", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/created", "target": "findings[].source_extra.created", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/published", "target": "findings[].vulnerability.published_at", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/updated", "target": "findings[].vulnerability.modified_at", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/rejected", "target": "findings[].source_extra.rejected", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/credits/**", "ignored": "people and organizations credited; names and contacts"},
    {"path": "/vulnerabilities[]/tools/**", "ignored": "the tools that found the vulnerability"},
    {"path": "/vulnerabilities[]/tools[]/**", "ignored": "the tools that found the vulnerability"},
    {"path": "/vulnerabilities[]/analysis", "target": "findings[].vex, vex[]", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/analysis/state", "target": "findings[].vex.status, vex[].vex.status; no finding for not_affected, resolved, resolved_with_pedigree, false_positive", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/analysis/justification", "target": "findings[].vex.justification, native_justification", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/analysis/response", "target": "(container)"},
    {"path": "/vulnerabilities[]/analysis/response[]", "target": "findings[].source_extra.analysis_response", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/analysis/detail", "target": "findings[].vex.statement", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/analysis/firstIssued", "target": "findings[].vex.as_of (when no lastUpdated)", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/analysis/lastUpdated", "target": "findings[].vex.as_of", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/affects", "target": "(container)"},
    {"path": "/vulnerabilities[]/affects[]", "target": "findings[] (one per affected component), vex[].products", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/affects[]/ref", "target": "findings[].vulnerability.package_name, purl, installed_version (the component), vex[].products", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/affects[]/versions", "target": "(container)"},
    {"path": "/vulnerabilities[]/affects[]/versions[]", "target": "findings[].source_extra.affects_versions", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/affects[]/versions[]/version", "target": "findings[].source_extra.affects_versions", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/affects[]/versions[]/range", "target": "findings[].source_extra.affects_versions", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/affects[]/versions[]/status", "target": "findings[].source_extra.affects_versions", "hook": "cyclonedx.vex"},
    {"path": "/vulnerabilities[]/properties", "target": "(container)"},
    {"path": "/vulnerabilities[]/properties[]", "target": "(container)"},
    {"path": "/vulnerabilities[]/properties[]/name", "target": "findings[].source_extra.property:<name> (key)", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/vulnerabilities[]/properties[]/value", "target": "findings[].source_extra.property:<name>", "hook": "cyclonedx.vulnerabilities"},
    {"path": "/services", "ignored": "services of the product (endpoints, data flows); not imported"},
    {"path": "/services[]/**", "ignored": "services of the product (endpoints, data flows); not imported"},
    {"path": "/externalReferences", "ignored": "links about the product"},
    {"path": "/externalReferences[]/**", "ignored": "links about the product"},
    {"path": "/compositions", "ignored": "completeness claims of the BOM"},
    {"path": "/compositions[]/**", "ignored": "completeness claims of the BOM"},
    {"path": "/annotations", "ignored": "comments by people; names and text"},
    {"path": "/annotations[]/**", "ignored": "comments by people; names and text"},
    {"path": "/formulation/**", "ignored": "how the product was built"},
    {"path": "/properties", "ignored": "producer-specific properties of the BOM document"},
    {"path": "/properties[]/**", "ignored": "producer-specific properties of the BOM document"},
    {"path": "/signature/**", "ignored": "signature of the BOM; verification is the uploader's concern"},
    {"path": "/definitions/**", "ignored": "standards definitions (CycloneDX 1.6 attestations)"},
    {"path": "/declarations/**", "ignored": "conformance declarations (CycloneDX 1.6 attestations)"}
  ]
}
