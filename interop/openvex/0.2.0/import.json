{
  "apiVersion": "openctem.io/interop/v1",
  "format": "openvex",
  "version": "0.2.0",
  "direction": "import",
  "namespace": "org.ctis.interop.openvex",
  "title": "OpenVEX",
  "source": "OpenVEX v0.2.0 (the v0.0.1 string forms of vulnerability, products and subcomponents are read too)",
  "detect": [{"pointer": "/@context", "matches": "openvex\\.dev/ns"}],
  "notes": [
    "This mapping reads OpenVEX 0.2.0 and the earlier contexts (https://openvex.dev/ns, v0.0.1), whose members are a subset.",
    "An OpenVEX document describes products, not findings: the report has no assets or findings, and Result.VEX holds one statement per OpenVEX statement.",
    "Statuses and justifications are the CTIS VEX vocabulary already. A not_affected statement needs a justification or an impact statement; without either it is skipped with an issue.",
    "Statement text: impact_statement (not_affected) or action_statement (affected), followed by status_notes.",
    "Products: identifiers.purl and identifiers.cpe23 (else cpe22) win; an @id that is a PURL or CPE fills the empty one; any other @id is the product name.",
    "Subcomponents narrow a product: they go to products[].subcomponents, and the statement is about those components inside that product only (a v0.0.1 statement-level subcomponents list narrows every product).",
    "Statement source: author (@id) of the document; as_of: the statement's last_updated or timestamp, else the document's."
  ],
  "hooks": ["openvex.document", "openvex.statements"],
  "fields": [
    {"path": "/@context", "target": "metadata.properties.openvex_context (format check)", "hook": "openvex.document"},
    {"path": "/@id", "target": "metadata.source_refs[], vex[].vex.source", "hook": "openvex.document"},
    {"path": "/author", "target": "vex[].vex.source, metadata.properties.author", "hook": "openvex.document"},
    {"path": "/role", "ignored": "the author's role (prose)"},
    {"path": "/timestamp", "target": "vex[].vex.as_of (when the statement has none)", "hook": "openvex.document"},
    {"path": "/last_updated", "target": "vex[].vex.as_of (when the statement has none)", "hook": "openvex.document"},
    {"path": "/version", "target": "metadata.properties.document_version", "hook": "openvex.document"},
    {"path": "/tooling", "target": "metadata.properties.tooling", "hook": "openvex.document"},
    {"path": "/statements", "target": "(container)"},
    {"path": "/statements[]", "target": "vex[]", "hook": "openvex.statements"},
    {"path": "/statements[]/@id", "ignored": "statement id; the document id is the source"},
    {"path": "/statements[]/version", "ignored": "statement revision"},
    {"path": "/statements[]/vulnerability", "target": "vex[].vulnerability_ids (v0.0.1 string, or the object below)", "hook": "openvex.statements"},
    {"path": "/statements[]/vulnerability/name", "target": "vex[].vulnerability_ids", "hook": "openvex.statements"},
    {"path": "/statements[]/vulnerability/aliases", "target": "(container)"},
    {"path": "/statements[]/vulnerability/aliases[]", "target": "vex[].vulnerability_ids", "hook": "openvex.statements"},
    {"path": "/statements[]/vulnerability/@id", "ignored": "IRI of the vulnerability record; name and aliases carry the ids"},
    {"path": "/statements[]/vulnerability/description", "ignored": "vulnerability prose; the statement text is kept"},
    {"path": "/statements[]/products", "target": "(container)"},
    {"path": "/statements[]/products[]", "target": "vex[].products[] (v0.0.1 string, or the object below)", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/@id", "target": "vex[].products[].purl, cpe or name", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/identifiers", "target": "(container)"},
    {"path": "/statements[]/products[]/identifiers/purl", "target": "vex[].products[].purl", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/identifiers/cpe23", "target": "vex[].products[].cpe", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/identifiers/cpe22", "target": "vex[].products[].cpe (when no cpe23)", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/hashes", "ignored": "artifact hashes; findings are matched on PURL and CPE"},
    {"path": "/statements[]/products[]/hashes/*", "ignored": "artifact hashes; findings are matched on PURL and CPE"},
    {"path": "/statements[]/products[]/subcomponents", "target": "(container)"},
    {"path": "/statements[]/products[]/subcomponents[]", "target": "vex[].products[].subcomponents[] (v0.0.1 string, or the object below)", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/subcomponents[]/@id", "target": "vex[].products[].subcomponents[].purl, cpe or name", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/subcomponents[]/identifiers", "target": "(container)"},
    {"path": "/statements[]/products[]/subcomponents[]/identifiers/purl", "target": "vex[].products[].subcomponents[].purl", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/subcomponents[]/identifiers/cpe23", "target": "vex[].products[].subcomponents[].cpe", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/subcomponents[]/identifiers/cpe22", "target": "vex[].products[].subcomponents[].cpe (when no cpe23)", "hook": "openvex.statements"},
    {"path": "/statements[]/products[]/subcomponents[]/hashes", "ignored": "artifact hashes; findings are matched on PURL and CPE"},
    {"path": "/statements[]/products[]/subcomponents[]/hashes/*", "ignored": "artifact hashes; findings are matched on PURL and CPE"},
    {"path": "/statements[]/subcomponents", "target": "(container)"},
    {"path": "/statements[]/subcomponents[]", "target": "vex[].products[].subcomponents[] (v0.0.1: narrows every product)", "hook": "openvex.statements"},
    {"path": "/statements[]/status", "target": "vex[].vex.status", "hook": "openvex.statements"},
    {"path": "/statements[]/status_notes", "target": "vex[].vex.statement (appended)", "hook": "openvex.statements"},
    {"path": "/statements[]/justification", "target": "vex[].vex.justification, native_justification", "hook": "openvex.statements"},
    {"path": "/statements[]/impact_statement", "target": "vex[].vex.statement (not_affected)", "hook": "openvex.statements"},
    {"path": "/statements[]/action_statement", "target": "vex[].vex.statement (affected)", "hook": "openvex.statements"},
    {"path": "/statements[]/action_statement_timestamp", "ignored": "when the action statement was written; the statement date is kept"},
    {"path": "/statements[]/timestamp", "target": "vex[].vex.as_of (when no last_updated)", "hook": "openvex.statements"},
    {"path": "/statements[]/last_updated", "target": "vex[].vex.as_of", "hook": "openvex.statements"},
    {"path": "/statements[]/supplier", "ignored": "who supplies the product, not who makes the statement"}
  ]
}
