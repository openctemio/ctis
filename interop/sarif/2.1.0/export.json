{
  "apiVersion": "openctem.io/interop/v1",
  "format": "sarif",
  "version": "2.1.0",
  "direction": "export",
  "namespace": "org.ctis.interop.sarif",
  "title": "SARIF 2.1.0",
  "source": "SARIF 2.1.0 (OASIS), one run per tool",
  "notes": [
    "Every member the exporter can write is listed here (the adapter test checks it against the output types); the members kept on import under extensions[\"org.ctis.interop.sarif\"] are written back only where this list leaves a place free.",
    "Accepted losses are listed in docs/exporters.md and in testdata/export/*.losses.json."
  ],
  "tables": {
    "confidence_precision": {"map": {"50": "low", "70": "medium", "85": "high", "95": "very-high"}},
    "kind_out": {"map": {"not_applicable": "notApplicable"}},
    "severity_level": {"default": "warning", "map": {"critical": "error", "high": "error", "info": "note", "low": "note", "medium": "warning", "unknown": "none"}},
    "severity_score": {"default": "0.0", "map": {"critical": "9.5", "high": "8.0", "low": "2.0", "medium": "5.5"}}
  },
  "hooks": ["sarif.code_flow", "sarif.location", "sarif.provenance", "sarif.result", "sarif.rules", "sarif.run", "sarif.suppressions", "sarif.web_exchange"],
  "fields": [
    {"path": "/$schema", "target": "the SARIF 2.1.0 schema URI", "hook": "sarif.run"},
    {"path": "/runs", "target": "(container)"},
    {"path": "/runs[]", "target": "one run per tool (findings with their own tool get a run of that tool)", "hook": "sarif.run"},
    {"path": "/runs[]/results", "target": "(container)"},
    {"path": "/runs[]/results[]", "target": "one result per finding, in report order", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/baselineState", "target": "baseline_state", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/codeFlows", "target": "data_flow as codeFlows[0].threadFlows[0]: steps in index order, kinds source, sink or sanitizer, function as the logical location, label as the message", "hook": "sarif.code_flow"},
    {"path": "/runs[]/results[]/codeFlows/**", "target": "the steps of data_flow", "hook": "sarif.code_flow"},
    {"path": "/runs[]/results[]/correlationGuid", "target": "correlation_id", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/fingerprints", "target": "(container)"},
    {"path": "/runs[]/results[]/fingerprints/*", "target": "fingerprint as fingerprints[\"ctis/v2\"]", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/kind", "target": "kind (table kind_out)", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/level", "target": "severity (table severity_level)", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/locations", "target": "location (the finding's one location)", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/logicalLocations", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/logicalLocations[]", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/logicalLocations[]/fullyQualifiedName", "target": "location.logical_location.fully_qualified_name", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/logicalLocations[]/kind", "target": "location.logical_location.kind", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/logicalLocations[]/name", "target": "location.logical_location.name", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/artifactLocation", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/artifactLocation/uri", "target": "location.path", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/artifactLocation/uriBaseId", "target": "not written", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region/endColumn", "target": "location.end_column", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region/endLine", "target": "location.end_line", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region/snippet", "target": "(container)"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region/snippet/text", "target": "location.snippet", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region/startColumn", "target": "location.start_column", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/locations[]/physicalLocation/region/startLine", "target": "location.start_line", "hook": "sarif.location"},
    {"path": "/runs[]/results[]/message", "target": "(container)"},
    {"path": "/runs[]/results[]/message/text", "target": "title, else message", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/partialFingerprints", "target": "(container)"},
    {"path": "/runs[]/results[]/partialFingerprints/*", "target": "partial_fingerprints", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/properties", "target": "(container)"},
    {"path": "/runs[]/results[]/properties/*", "target": "security-severity (severity, table severity_score), tags (tags)", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/properties/*/**", "target": "the values of those properties", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/rule", "target": "(container)"},
    {"path": "/runs[]/results[]/rule/id", "target": "not written", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/rule/index", "target": "not written", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/ruleId", "target": "the rule id", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/ruleIndex", "target": "the index of the rule in driver.rules", "hook": "sarif.result"},
    {"path": "/runs[]/results[]/suppressions", "target": "(container)"},
    {"path": "/runs[]/results[]/suppressions[]", "target": "suppression; status suppressed, false_positive or accepted_risk without one becomes an external, accepted suppression", "hook": "sarif.suppressions"},
    {"path": "/runs[]/results[]/suppressions[]/justification", "target": "suppression.justification", "hook": "sarif.suppressions"},
    {"path": "/runs[]/results[]/suppressions[]/kind", "target": "suppression.kind", "hook": "sarif.suppressions"},
    {"path": "/runs[]/results[]/suppressions[]/status", "target": "suppression.status", "hook": "sarif.suppressions"},
    {"path": "/runs[]/results[]/webRequest", "target": "the first http_exchange evidence item, request (sensitive values masked)", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/body", "target": "(container)"},
    {"path": "/runs[]/results[]/webRequest/body/binary", "target": "not written (bodies are text)", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/body/text", "target": "the body as text", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/headers", "target": "(container)"},
    {"path": "/runs[]/results[]/webRequest/headers/*", "target": "the headers (sensitive values masked)", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/method", "target": "request method", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/protocol", "target": "\"HTTP\" of the HTTP version", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/target", "target": "request URL", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webRequest/version", "target": "the HTTP version number", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse", "target": "the first http_exchange evidence item, response (sensitive values masked)", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/body", "target": "(container)"},
    {"path": "/runs[]/results[]/webResponse/body/binary", "target": "not written (bodies are text)", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/body/text", "target": "the body as text", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/headers", "target": "(container)"},
    {"path": "/runs[]/results[]/webResponse/headers/*", "target": "the headers (sensitive values masked)", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/noResponseReceived", "target": "not written", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/protocol", "target": "\"HTTP\" of the HTTP version", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/reasonPhrase", "target": "response reason", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/statusCode", "target": "response status", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/results[]/webResponse/version", "target": "the HTTP version number", "hook": "sarif.web_exchange"},
    {"path": "/runs[]/tool", "target": "(container)"},
    {"path": "/runs[]/tool/driver", "target": "(container)"},
    {"path": "/runs[]/tool/driver/informationUri", "target": "tool.info_url", "hook": "sarif.run"},
    {"path": "/runs[]/tool/driver/name", "target": "tool.name (finding.tool.name for its run; \"ctis\" without a tool)", "hook": "sarif.run"},
    {"path": "/runs[]/tool/driver/rules", "target": "(container)"},
    {"path": "/runs[]/tool/driver/rules[]", "target": "one rule per rule id, defined by the first finding of that id, sorted by id", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/defaultConfiguration", "target": "(container)"},
    {"path": "/runs[]/tool/driver/rules[]/defaultConfiguration/level", "target": "severity (table severity_level)", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/fullDescription", "target": "(container)"},
    {"path": "/runs[]/tool/driver/rules[]/fullDescription/text", "target": "not written", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/help", "target": "(container)"},
    {"path": "/runs[]/tool/driver/rules[]/help/text", "target": "remediation.recommendation", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/helpUri", "target": "references[0]", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/id", "target": "rule_id (ctis/<type> without one)", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/name", "target": "rule_name", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/properties", "target": "(container)"},
    {"path": "/runs[]/tool/driver/rules[]/properties/*", "target": "security-severity (severity, table severity_score), precision (confidence, table confidence_precision), cwe (vulnerability.cwe_ids), owasp (vulnerability.owasp_ids), tags (the type when the rule id and tool name would not give it back)", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/properties/*/**", "target": "the values of those properties", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/rules[]/shortDescription", "target": "(container)"},
    {"path": "/runs[]/tool/driver/rules[]/shortDescription/text", "target": "description", "hook": "sarif.rules"},
    {"path": "/runs[]/tool/driver/semanticVersion", "target": "not written", "hook": "sarif.run"},
    {"path": "/runs[]/tool/driver/version", "target": "tool.version", "hook": "sarif.run"},
    {"path": "/runs[]/versionControlProvenance", "target": "(container)"},
    {"path": "/runs[]/versionControlProvenance[]", "target": "metadata.branch", "hook": "sarif.provenance"},
    {"path": "/runs[]/versionControlProvenance[]/branch", "target": "metadata.branch.name", "hook": "sarif.provenance"},
    {"path": "/runs[]/versionControlProvenance[]/repositoryUri", "target": "metadata.branch.repository_url", "hook": "sarif.provenance"},
    {"path": "/runs[]/versionControlProvenance[]/revisionId", "target": "metadata.branch.commit_sha", "hook": "sarif.provenance"},
    {"path": "/version", "target": "\"2.1.0\"", "hook": "sarif.run"}
  ]
}
